page {
  background: #F6F1E7;
  color: #3D362A;
  font-size: 28rpx;
  line-height: 1.6;
  font-family: -apple-system, BlinkMacSystemFont, "Helvetica Neue", "PingFang SC", "Microsoft YaHei", sans-serif;
}

/* ---------- 主色板：大地棕 + 暖米白 + 轻奢金（松赞调性） ---------- */
/* 主棕 #8A7152 深棕 #5F4B33 浅卡其 #EDE4D2 米色底 #F6F1E7 米色 #EFE7D5 金 #C6A870 */

view, text, input, textarea, button, swiper, scroll-view, image {
  box-sizing: border-box;
}

.card {
  background: #FCF9F1;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 82, 66, 0.04);
}

.section {
  margin-top: 40rpx;
  padding: 0 28rpx;
}

.section-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 24rpx;
}

.section-title {
  display: flex;
  align-items: center;
  font-size: 34rpx;
  font-weight: 500;
  color: #443A2C;
}

.section-title::before {
  content: "";
  display: block;
  width: 8rpx;
  height: 30rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #8A7152, #C6A870);
  margin-right: 14rpx;
}

.section-more {
  font-size: 24rpx;
  color: #948D7D;
}

.btn-primary {
  background: linear-gradient(135deg, #8A7152, #5F4B33);
  color: #FCF9F1;
  border-radius: 44rpx;
  font-size: 30rpx;
  font-weight: 500;
  line-height: 88rpx;
  height: 88rpx;
  text-align: center;
  border: none;
}

.btn-primary::after {
  border: none;
}

.btn-outline {
  background: #FCF9F1;
  color: #8A7152;
  border: 2rpx solid #8A7152;
  border-radius: 44rpx;
  font-size: 30rpx;
  line-height: 84rpx;
  height: 88rpx;
  text-align: center;
}

.btn-outline::after {
  border: none;
}

.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: #EDE4D2;
  color: #8A7152;
  margin-right: 10rpx;
}

.tag-gold {
  background: #EFE5CF;
  color: #B08A3E;
}

.tag-orange {
  background: #FDF0E8;
  color: #A4653A;
}

.price {
  color: #A4653A;
  font-weight: 600;
}

.price-symbol {
  font-size: 22rpx;
}

.price-num {
  font-size: 40rpx;
}

.price-old {
  color: #B0A997;
  font-size: 22rpx;
  text-decoration: line-through;
  font-weight: 400;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.flex-row {
  display: flex;
  align-items: center;
}

.flex-between {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.empty {
  padding: 120rpx 0;
  text-align: center;
  color: #A59E8D;
  font-size: 26rpx;
}

.empty-icon {
  width: 160rpx;
  height: 160rpx;
  margin: 0 auto 20rpx;
  border-radius: 50%;
  background: #EDE5D6;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 56rpx;
  color: #C7C0AC;
}

/* 底部占位，避免悬浮按钮遮挡内容 */
.safe-bottom {
  height: 160rpx;
}
