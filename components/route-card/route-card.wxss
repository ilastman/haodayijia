.rc {
  background: #FCF9F1;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(90, 82, 66, 0.04);
}

/* 组件内本地化（不依赖 app.wxss，确保样式隔离下生效） */
.tag {
  display: inline-block;
  padding: 4rpx 14rpx;
  border-radius: 8rpx;
  font-size: 20rpx;
  background: #EDE4D2;
  color: #8A7152;
  margin-right: 10rpx;
  margin-bottom: 6rpx;
}

.ellipsis-2 {
  display: -webkit-box;
  -webkit-box-orient: vertical;
  -webkit-line-clamp: 2;
  overflow: hidden;
}

.cover-box {
  position: relative;
  width: 100%;
}

.cover {
  width: 100%;
  display: block;
  background: #EDE5D6;
}

.rc-grid .cover {
  height: 300rpx;
}

.rc-wide .cover {
  height: 320rpx;
}

.fav {
  position: absolute;
  top: 16rpx;
  right: 16rpx;
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: rgba(255, 255, 255, 0.92);
  color: #9A9A9A;
  font-size: 30rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.fav-on {
  color: #A4653A;
}

.type-badge {
  position: absolute;
  left: 0;
  bottom: 0;
  background: linear-gradient(135deg, rgba(47, 143, 91, 0.95), rgba(30, 122, 76, 0.95));
  color: #FCF9F1;
  font-size: 20rpx;
  padding: 6rpx 18rpx;
  border-radius: 0 16rpx 0 0;
}

.info {
  padding: 18rpx 20rpx 22rpx;
}

.title {
  font-size: 28rpx;
  font-weight: 500;
  color: #443A2C;
  line-height: 1.45;
  min-height: 80rpx;
}

.tags {
  margin-top: 12rpx;
}

.meta {
  display: flex;
  align-items: center;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #948D7D;
}

.days {
  background: #EFE7D5;
  color: #B08A3E;
  border-radius: 6rpx;
  padding: 2rpx 10rpx;
  margin-right: 12rpx;
}

.dep {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 14rpx;
}

.price {
  color: #A4653A;
  font-weight: 600;
}

.price-symbol {
  font-size: 22rpx;
}

.price-num {
  font-size: 38rpx;
}

.per {
  font-size: 20rpx;
  font-weight: 400;
  color: #948D7D;
}

.price-old {
  color: #B0A997;
  font-size: 22rpx;
  text-decoration: line-through;
}
