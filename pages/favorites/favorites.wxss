.page {
  padding-top: 24rpx;
  min-height: 100vh;
}

.list {
  padding: 0 24rpx;
}

.fav-card {
  display: flex;
  background: #FCF9F1;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(90, 82, 66, 0.04);
  margin-bottom: 24rpx;
}

.fav-cover {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  background: #EDE5D6;
}

.fav-info {
  flex: 1;
  padding: 20rpx 22rpx;
  min-width: 0;
}

.fav-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #443A2C;
  line-height: 1.45;
}

.tags {
  margin-top: 10rpx;
}

.fav-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #948D7D;
}

.fav-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 14rpx;
}

.price {
  color: #A4653A;
  font-weight: 600;
}

.price-symbol {
  font-size: 22rpx;
}

.price-num {
  font-size: 36rpx;
}

.per {
  font-size: 20rpx;
  font-weight: 400;
  color: #948D7D;
}

.fav-go {
  font-size: 22rpx;
  color: #8A7152;
}
