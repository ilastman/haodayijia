.page {
  padding-bottom: 20rpx;
}

/* Banner */
.banner {
  width: 100%;
  height: 400rpx;
}

.banner-img {
  width: 100%;
  height: 400rpx;
  display: block;
  background: #EDE5D6;
}

/* 首图下私人定制名片 */
.custom-card {
  align-self: stretch;
  margin: 20rpx 24rpx 0;
  border-radius: 28rpx;
  overflow: hidden;
  background: #F6EBD8;
  box-shadow: 0 10rpx 28rpx rgba(90, 70, 40, 0.08);
}

.custom-card-on {
  opacity: 0.92;
}

.custom-card-img {
  width: 100%;
  display: block;
}

/* 图标导航：浅米色底、深棕线稿，五项等分 */
.nav-bar {
  align-self: stretch;
  display: flex;
  align-items: flex-start;
  background: #FBF7F0;
  margin: 16rpx 24rpx 0;
  border-radius: 32rpx;
  padding: 22rpx 4rpx 18rpx;
  box-shadow: 0 6rpx 24rpx rgba(90, 70, 40, 0.05);
  position: relative;
}

.nav-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-icon {
  width: 56rpx;
  height: 56rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-icon-img {
  width: 48rpx;
  height: 48rpx;
}

.nav-label {
  margin-top: 8rpx;
  font-size: 22rpx;
  line-height: 1.2;
  color: #5C4632;
  white-space: nowrap;
}

/* 热门线路横滑 */
.hot-scroll {
  white-space: nowrap;
  width: 100%;
}

.hot-card {
  display: inline-block;
  width: 440rpx;
  margin-right: 20rpx;
  vertical-align: top;
  white-space: normal;
}

.hot-holder {
  display: inline-block;
  width: 8rpx;
}

/* 目的地 */
.dest-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.dest-item {
  position: relative;
  width: 48.5%;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.dest-img {
  width: 100%;
  height: 100%;
  display: block;
  background: #EDE5D6;
}

.dest-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 35%, rgba(60, 50, 38, 0.4) 100%);
}

.dest-name {
  position: absolute;
  left: 20rpx;
  bottom: 16rpx;
  color: #FCF9F1;
  font-size: 28rpx;
  font-weight: 500;
}

/* 特惠推荐 */
.offer-card {
  display: flex;
  background: #FCF9F1;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(90, 82, 66, 0.04);
  margin-bottom: 24rpx;
}

.offer-img {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  background: #EDE5D6;
}

.offer-info {
  flex: 1;
  padding: 20rpx 22rpx;
  min-width: 0;
}

.offer-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #443A2C;
  line-height: 1.45;
}

.tags {
  margin-top: 10rpx;
}

.offer-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #948D7D;
}

.offer-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.price {
  color: #A4653A;
  font-weight: 600;
}

.price-symbol {
  font-size: 22rpx;
}

.price-num {
  font-size: 38rpx;
}

.per {
  font-size: 20rpx;
  font-weight: 400;
  color: #948D7D;
}

.price-old {
  color: #B0A997;
  font-size: 22rpx;
  text-decoration: line-through;
}

/* 公司介绍 */
.intro {
  margin: 40rpx 28rpx 0;
  background: #EFE7D5;
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
}

.intro-text {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #817A6A;
  line-height: 1.8;
}

.intro-phone {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8A7152;
  font-weight: 500;
}

/* 悬浮咨询 */
.float-consult {
  position: fixed;
  left: 50%;
  bottom: 32rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 56rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #8A7152, #5F4B33);
  color: #FCF9F1;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 10rpx 30rpx rgba(95, 75, 51, 0.2);
  z-index: 100;
}

.float-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}
