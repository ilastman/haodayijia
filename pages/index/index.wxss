.page {
  padding-bottom: 20rpx;
}

/*
 * 封面轮播
 * 高 880rpx：约首屏内容区 65%（宽 750 稿，扣除状态栏+导航栏+tabBar 后可视高度约 1290rpx）。
 * 导航以 -80rpx 叠在封面下沿，圆角与页面底色连成一块，指示点留在照片上。
 */
.home-hero {
  position: relative;
}

.banner,
.banner-img {
  width: 100%;
  height: 880rpx;
}

.banner-img {
  display: block;
  background: #C4B49A;
}

.banner-scrim {
  position: absolute;
  left: 0;
  right: 0;
  bottom: 0;
  height: 280rpx;
  background: linear-gradient(180deg, rgba(36, 28, 20, 0) 0%, rgba(36, 28, 20, 0.16) 48%, rgba(36, 28, 20, 0.38) 100%);
  pointer-events: none;
}

/* 指示点抬到圆角面板之上（面板上叠 80rpx，点底边再留约 36rpx） */
.banner .wx-swiper-dots,
.banner .wx-swiper-dots-horizontal {
  bottom: 116rpx;
}

.banner .wx-swiper-dot {
  width: 10rpx !important;
  height: 10rpx !important;
  margin: 0 6rpx !important;
  border-radius: 10rpx !important;
}

.banner .wx-swiper-dot-active {
  width: 28rpx !important;
  border-radius: 10rpx !important;
}

/* 图标导航：无底色块，单色线稿直接落在封面交界的浅底上 */
.nav-bar {
  display: flex;
  align-items: flex-start;
  position: relative;
  z-index: 3;
  margin: -80rpx 0 0;
  padding: 32rpx 4rpx 8rpx;
  background: #F6F1E7;
  border-radius: 40rpx 40rpx 0 0;
  box-shadow: 0 -14rpx 32rpx rgba(48, 38, 28, 0.08);
}

.nav-item {
  flex: 1;
  min-width: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.nav-item-on {
  opacity: 0.55;
}

.nav-icon {
  width: 52rpx;
  height: 52rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: transparent;
}

.nav-icon-img {
  width: 44rpx;
  height: 44rpx;
}

.nav-label {
  margin-top: 10rpx;
  max-width: 100%;
  font-size: 22rpx;
  line-height: 1.2;
  font-weight: 500;
  color: #4A3F32;
  white-space: nowrap;
}

.home-hero + .section {
  margin-top: 28rpx;
}

/* 热门线路横滑 */
.hot-scroll {
  white-space: nowrap;
  width: 100%;
}

.hot-card {
  display: inline-block;
  width: 440rpx;
  margin-right: 20rpx;
  vertical-align: top;
  white-space: normal;
}

.hot-holder {
  display: inline-block;
  width: 8rpx;
}

/* 目的地 */
.dest-grid {
  display: flex;
  flex-wrap: wrap;
  justify-content: space-between;
}

.dest-item {
  position: relative;
  width: 48.5%;
  height: 200rpx;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 20rpx;
}

.dest-img {
  width: 100%;
  height: 100%;
  display: block;
  background: #EDE5D6;
}

.dest-mask {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(0, 0, 0, 0) 35%, rgba(60, 50, 38, 0.4) 100%);
}

.dest-name {
  position: absolute;
  left: 20rpx;
  bottom: 16rpx;
  color: #FCF9F1;
  font-size: 28rpx;
  font-weight: 500;
}

/* 特惠推荐 */
.offer-card {
  display: flex;
  background: #FCF9F1;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(90, 82, 66, 0.04);
  margin-bottom: 24rpx;
}

.offer-img {
  width: 240rpx;
  height: 240rpx;
  flex-shrink: 0;
  background: #EDE5D6;
}

.offer-info {
  flex: 1;
  padding: 20rpx 22rpx;
  min-width: 0;
}

.offer-title {
  font-size: 28rpx;
  font-weight: 500;
  color: #443A2C;
  line-height: 1.45;
}

.tags {
  margin-top: 10rpx;
}

.offer-meta {
  margin-top: 10rpx;
  font-size: 22rpx;
  color: #948D7D;
}

.offer-price-row {
  display: flex;
  align-items: baseline;
  justify-content: space-between;
  margin-top: 12rpx;
}

.price {
  color: #A4653A;
  font-weight: 600;
}

.price-symbol {
  font-size: 22rpx;
}

.price-num {
  font-size: 38rpx;
}

.per {
  font-size: 20rpx;
  font-weight: 400;
  color: #948D7D;
}

.price-old {
  color: #B0A997;
  font-size: 22rpx;
  text-decoration: line-through;
}

/* 公司介绍 */
.intro {
  margin: 40rpx 28rpx 0;
  background: #EFE7D5;
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
}

.intro-text {
  display: block;
  margin-top: 18rpx;
  font-size: 24rpx;
  color: #817A6A;
  line-height: 1.8;
}

.intro-phone {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #8A7152;
  font-weight: 500;
}

/* 悬浮咨询 */
.float-consult {
  position: fixed;
  left: 50%;
  bottom: 32rpx;
  transform: translateX(-50%);
  display: flex;
  align-items: center;
  justify-content: center;
  height: 88rpx;
  padding: 0 56rpx;
  border-radius: 44rpx;
  background: linear-gradient(135deg, #8A7152, #5F4B33);
  color: #FCF9F1;
  font-size: 30rpx;
  font-weight: 500;
  box-shadow: 0 10rpx 30rpx rgba(95, 75, 51, 0.2);
  z-index: 100;
}

.float-icon {
  width: 36rpx;
  height: 36rpx;
  margin-right: 12rpx;
}
