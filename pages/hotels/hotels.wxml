<view class="page">

  <!-- 头部 -->
  <view class="head">
    <view class="head-title">{{title}}</view>
    <view class="head-sub">{{subtitle}}</view>
    <view class="head-search">
      <image class="pin" src="{{pinIcon}}" mode="aspectFit" />
      <text>呼伦贝尔 · 阿尔山 · 满洲里 沿线酒店</text>
    </view>
  </view>

  <!-- 一级大区筛选 -->
  <scroll-view scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="region-scroll">
    <view class="region {{activeRegion === item ? 'on' : ''}}" wx:for="{{regions}}" wx:key="*this" bindtap="onRegion" data-region="{{item}}">{{item}}</view>
  </scroll-view>

  <!-- 二级地点筛选：随所选大区过滤 -->
  <scroll-view scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="cat-scroll">
    <view class="cat {{activePlace === item ? 'on' : ''}}" wx:for="{{places}}" wx:key="*this" bindtap="onPlace" data-place="{{item}}">{{item}}</view>
  </scroll-view>

  <!-- 酒店列表 -->
  <view class="list" wx:if="{{list.length > 0}}">
    <view class="hotel" wx:for="{{list}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <image class="hotel-img" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
      <view class="hotel-info">
        <view class="hotel-name-row">
          <text class="hotel-name ellipsis">{{item.name}}</text>
          <text class="hotel-score">{{item.score}}{{scoreLabel}}</text>
        </view>
        <view class="hotel-meta">{{item.stars}} · {{item.area}}</view>
        <view class="tags">
          <text class="tag" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
        <view class="hotel-price-row">
          <view class="price">
            <text class="price-symbol">¥</text>
            <text class="price-num">{{item.price}}</text>
            <text class="per">{{perNight}}</text>
          </view>
          <view class="book-btn" catchtap="book" data-name="{{item.name}}">{{bookLabel}}</view>
        </view>
      </view>
    </view>
  </view>

  <view class="empty" wx:else>
    <view class="empty-icon">◇</view>
    <text>{{emptyText}}</text>
  </view>

  <view class="safe-bottom"></view>

  <consult-modal visible="{{consultVisible}}" route-title="{{currentName}}" bind:close="onConsultClose" />
</view>
