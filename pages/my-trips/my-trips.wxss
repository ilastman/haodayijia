.page {
  min-height: 100vh;
  padding-bottom: 24rpx;
  background: #FAF7F0;
}

.mt-head {
  padding: 30rpx 28rpx 6rpx;
}

.mt-title {
  font-size: 40rpx;
  font-weight: 300;
  letter-spacing: 4rpx;
  color: #3D362A;
}

.mt-sub {
  margin-top: 10rpx;
  font-size: 23rpx;
  color: #9E9886;
}

.mt-list {
  padding: 12rpx 24rpx 0;
}

.mt-row {
  position: relative;
  overflow: hidden;
  border-radius: 24rpx;
  margin-bottom: 40rpx;
}

.mt-del {
  position: absolute;
  top: 0;
  right: 0;
  bottom: 0;
  width: 150rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F7EDE8;
  color: #B4685B;
  font-size: 26rpx;
  letter-spacing: 2rpx;
}

.mt-card {
  position: relative;
  z-index: 1;
  background: #FCF9F1;
  border: 1rpx solid #F0EADC;
  border-radius: 24rpx;
  padding: 0;
  transition: transform .24s ease;
}

.mt-card.on {
  transform: translateX(-150rpx);
}

.mt-cover {
  width: 100%;
  height: 470rpx;
  display: block;
  background: #EDE5D6;
}

.mt-del-btn {
  position: absolute;
  top: 22rpx;
  right: 22rpx;
  z-index: 2;
  padding: 9rpx 26rpx;
  font-size: 22rpx;
  letter-spacing: 3rpx;
  color: #8A7F6A;
  background: rgba(252, 249, 241, 0.9);
  border: 1rpx solid rgba(240, 234, 220, 0.9);
  border-radius: 999rpx;
}

.mt-body {
  display: flex;
  flex-direction: column;
  padding: 26rpx 26rpx 30rpx;
}

.mt-days {
  font-size: 21rpx;
  color: #ADA690;
  letter-spacing: 3rpx;
}

.mt-name-row {
  display: flex;
  align-items: baseline;
  margin-top: 14rpx;
}

.mt-name {
  flex: 1;
  min-width: 0;
  font-size: 30rpx;
  font-weight: 400;
  color: #3D362A;
  line-height: 1.45;
}

.mt-quote {
  flex: 0 0 auto;
  margin-left: 16rpx;
  font-size: 28rpx;
  font-weight: 600;
  color: #A4653A;
}

.mt-brief {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #817A6A;
  line-height: 1.6;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.mt-empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 60rpx 0;
}

.mt-empty-icon {
  font-size: 64rpx;
  color: #D8D0BD;
}

.mt-empty-text {
  margin-top: 28rpx;
  font-size: 28rpx;
  color: #817A6A;
}

.mt-empty-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #ADA690;
  text-align: center;
  line-height: 1.7;
}

.mt-empty-btn {
  margin-top: 44rpx;
  padding: 20rpx 56rpx;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  color: #FCF9F1;
  background: #8A7152;
  border-radius: 999rpx;
}

.safe-bottom {
  height: 60rpx;
}

/* 删除二次确认 */
.mt-mask {
  position: fixed;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  z-index: 60;
  background: rgba(28, 22, 14, 0.42);
  display: flex;
  align-items: center;
  justify-content: center;
}

.mt-dialog {
  width: 560rpx;
  background: #FCF9F1;
  border-radius: 24rpx;
  padding: 46rpx 36rpx 30rpx;
  box-sizing: border-box;
}

.mt-dialog-text {
  font-size: 29rpx;
  color: #3D362A;
  line-height: 1.6;
  text-align: center;
  letter-spacing: 1rpx;
}

.mt-dialog-row {
  display: flex;
  margin-top: 42rpx;
}

.mt-dialog-btn {
  flex: 1;
  text-align: center;
  padding: 20rpx 0;
  font-size: 29rpx;
  color: #817A6A;
  background: #F2ECE0;
  border-radius: 16rpx;
}

.mt-dialog-btn.danger {
  margin-left: 22rpx;
  color: #A85C50;
  background: #F3E4DE;
}