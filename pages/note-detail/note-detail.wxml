<view class="page" wx:if="{{note}}">

  <!-- 顶部通栏封面大图 -->
  <image class="cover" src="{{note.coverV}}" mode="widthFix" />

  <!-- 留白：标题 + 发布人信息 -->
  <view class="base">
    <view class="base-title">{{note.title}}</view>
    <view class="base-tags">
      <text class="base-tag" wx:for="{{note.tags}}" wx:key="*this">{{item}}</text>
    </view>
    <view class="p-author">
      <image class="p-avatar" src="{{note.author.avatar}}" mode="aspectFill" />
      <text class="p-name">{{note.author.name}}</text>
      <text class="p-time">{{c.day}} {{note.time}}</text>
    </view>
  </view>

  <!-- 游记正文 -->
  <view class="block" wx:if="{{note.content.length > 0}}">
    <view class="block-title">{{c.contentTitle}}</view>
    <view class="para" wx:for="{{note.content}}" wx:key="index">{{item}}</view>
  </view>

  <!-- 随拍轮播 -->
  <view class="block" wx:if="{{note.images.length > 0}}">
    <view class="block-title">{{c.photosTitle}}</view>
    <swiper class="gallery" indicator-dots="{{true}}" indicator-active-color="#8A7152"
      indicator-color="rgba(138, 113, 82, .25)" circular="{{false}}" autoplay="{{false}}">
      <swiper-item wx:for="{{note.images}}" wx:key="*this" bindtap="previewImage" data-src="{{item}}">
        <image class="gallery-img" src="{{item}}" mode="aspectFill" />
      </swiper-item>
    </swiper>
  </view>

  <!-- 评论区 -->
  <view class="block">
    <view class="block-title comments-title">{{c.comments}}</view>
    <view class="comment" wx:for="{{comments}}" wx:for-item="cm" wx:key="index">
      <image class="c-avatar" src="{{cm.avatar}}" mode="aspectFill" />
      <view class="c-body">
        <text class="c-name">{{cm.name}}</text>
        <text class="c-text">{{cm.text}}</text>
        <text class="c-likes" wx:if="{{cm.likes > 0}}">{{cm.likes}} {{c.like}}</text>
      </view>
    </view>
    <view class="no-comment" wx:if="{{comments.length === 0}}">{{c.noComment}}</view>
  </view>

  <view class="safe-bottom"></view>

  <!-- 底部互动栏 -->
  <view class="bar">
    <input class="bar-input" placeholder="{{c.commentPlaceholder}}" placeholder-class="ph"
      value="{{commentDraft}}" confirm-type="send" maxlength="60"
      bindinput="onCommentInput" bindconfirm="onCommentSend" />
    <view class="act {{liked ? 'on' : ''}}" bindtap="onLike">
      <text class="act-ico">{{liked ? '♥' : '♡'}}</text>
      <text class="act-label">{{liked ? c.liked : c.like}}</text>
    </view>
    <view class="act {{faved ? 'on' : ''}}" bindtap="onFav">
      <text class="act-ico">{{faved ? '★' : '☆'}}</text>
      <text class="act-label">{{faved ? c.faved : c.fav}}</text>
    </view>
  </view>
</view>