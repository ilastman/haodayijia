.page {
  background: #F6F1E7;
  padding-bottom: 20rpx;
}

/* 通栏封面 */
.cover {
  width: 100%;
  display: block;
  background: #EDE5D6;
}

/* 留白基础信息 */
.base {
  background: #FCF9F1;
  border-radius: 0 0 28rpx 28rpx;
  padding: 34rpx 30rpx 36rpx;
  box-shadow: 0 6rpx 20rpx rgba(90, 82, 66, 0.04);
}

.base-title {
  font-size: 38rpx;
  font-weight: 400;
  color: #3D362A;
  line-height: 1.5;
}

.base-tags {
  margin-top: 16rpx;
}

.base-tag {
  display: inline-block;
  font-size: 21rpx;
  color: #817A6A;
  border: 1rpx solid #DED6C3;
  border-radius: 20rpx;
  padding: 4rpx 16rpx;
  margin-right: 12rpx;
}

.p-author {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
}

.p-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EDE5D6;
}

.p-name {
  font-size: 26rpx;
  color: #443A2C;
  margin-left: 16rpx;
}

.p-time {
  font-size: 23rpx;
  color: #A79F8D;
  margin-left: 18rpx;
}

/* 信息块 */
.block {
  background: #FCF9F1;
  border-radius: 24rpx;
  margin: 24rpx 24rpx 0;
  padding: 30rpx 28rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #443A2C;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 18rpx;
}

.block-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: #8A7152;
}

.para {
  font-size: 27rpx;
  color: #4A4A4A;
  line-height: 1.85;
  margin-bottom: 22rpx;
}

.para:last-child {
  margin-bottom: 0;
}

.gallery {
  width: 100%;
  height: 380rpx;
  border-radius: 16rpx;
  overflow: hidden;
  background: #EDE5D6;
}

.gallery-img {
  width: 100%;
  height: 380rpx;
  display: block;
}

/* 评论 */
.comment {
  display: flex;
  margin-top: 22rpx;
}

.c-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EDE5D6;
  flex-shrink: 0;
}

.c-body {
  flex: 1;
  margin-left: 18rpx;
  min-width: 0;
}

.c-name {
  font-size: 23rpx;
  color: #A79F8D;
  display: block;
}

.c-text {
  font-size: 26rpx;
  color: #3D362A;
  line-height: 1.6;
  margin-top: 6rpx;
  display: block;
}

.c-likes {
  font-size: 21rpx;
  color: #A79F8D;
  margin-top: 8rpx;
  display: block;
}

.no-comment {
  font-size: 25rpx;
  color: #A79F8D;
  padding: 10rpx 0;
}

/* 底部互动栏 */
.safe-bottom {
  height: 150rpx;
}

.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FCF9F1;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  padding-bottom: calc(16rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 20rpx rgba(90, 82, 66, 0.06);
}

.bar-input {
  flex: 1;
  background: #F0EADB;
  border-radius: 32rpx;
  height: 64rpx;
  padding: 0 28rpx;
  font-size: 25rpx;
  color: #3D362A;
}

.act {
  display: flex;
  align-items: center;
  margin-left: 28rpx;
  flex-shrink: 0;
}

.act-ico {
  font-size: 32rpx;
  color: #A79F8D;
  line-height: 1;
}

.act.on .act-ico {
  color: #A4653A;
}

.act-label {
  font-size: 22rpx;
  color: #817A6A;
  margin-left: 8rpx;
}