<view class="page">

  <!-- 用户信息区 -->
  <view class="profile">
    <view class="profile-bg"></view>

    <block wx:if="{{userInfo}}">
      <image class="avatar" src="{{userInfo.avatar}}" mode="aspectFill" wx:if="{{userInfo.avatar}}" />
      <view class="avatar avatar-empty" wx:else>{{userInfo.nickname[0]}}</view>
      <view class="nick-row">
        <input class="nick-input" type="nickname" placeholder="{{copy.nicknamePlaceholder}}" placeholder-class="nick-ph"
          value="{{editNick}}" bindinput="onNickInput" bindconfirm="saveProfile" />
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">{{copy.avatarBtn}}</button>
      </view>
      <view class="nick-tip" bindtap="saveProfile">{{copy.confirmSave}} ›</view>
    </block>

    <block wx:else>
      <image class="avatar" src="{{userIcon}}" mode="aspectFit" />
      <view class="nick">{{copy.notLogin}}</view>
      <view class="login-tip">{{copy.loginTip}}</view>
      <view class="nick-row">
        <input class="nick-input" type="nickname" placeholder="{{copy.nicknamePlaceholder}}" placeholder-class="nick-ph"
          value="{{editNick}}" bindinput="onNickInput" />
        <button class="avatar-btn" open-type="chooseAvatar" bindchooseavatar="onChooseAvatar">{{copy.avatarBtn}}</button>
      </view>
      <button class="login-btn" bindtap="saveProfile">{{copy.loginBtn}}</button>
    </block>
  </view>

  <!-- 功能菜单 -->
  <view class="menu">
    <view class="menu-item" wx:for="{{menu}}" wx:key="key" bindtap="onMenu" data-url="{{item.url}}">
      <text class="menu-label">{{item.label}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 客服电话 -->
  <view class="service" bindtap="callService">
    <image class="service-icon" src="{{phoneIcon}}" mode="aspectFit" />
    <view class="service-info">
      <view class="service-label">{{copy.phoneLabel}}</view>
      <view class="service-phone">{{servicePhone}}</view>
      <view class="service-hours">{{serviceHours}}</view>
    </view>
    <view class="service-call">{{copy.callNow}}</view>
  </view>

  <view class="safe-bottom"></view>
</view>
