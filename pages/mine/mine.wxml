<view class="page">

  <!-- 用户信息区 -->
  <view class="profile">
    <view class="profile-bg"></view>

    <view class="avatar-wrap" bindtap="onAvatarTap">
      <image class="avatar" src="{{editAvatar}}" mode="aspectFill" wx:if="{{editAvatar}}" />
      <view class="avatar avatar-empty" wx:else>{{(editNick && editNick[0]) || '旅'}}</view>
      <view class="avatar-edit">{{copy.avatarBtn}}</view>
    </view>

    <view class="nick-row">
      <input class="nick-input" type="nickname" placeholder="{{copy.nicknamePlaceholder}}" placeholder-class="nick-ph"
        value="{{editNick}}" bindinput="onNickInput" bindconfirm="saveProfile" />
    </view>
    <view class="nick-tip" bindtap="saveProfile">{{copy.confirmSave}} ›</view>
  </view>

  <!-- 功能菜单 -->
  <view class="staff-chip" wx:if="{{isStaff}}">员工账号 · {{staffName}}</view>
  <view class="menu">
    <view class="menu-item" wx:for="{{menu}}" wx:key="key" bindtap="onMenu" data-url="{{item.url}}">
      <text class="menu-label">{{item.label}}</text>
      <text class="menu-arrow">›</text>
    </view>
  </view>

  <!-- 客服电话 -->
  <view class="service" bindtap="callService">
    <image class="service-icon" src="{{phoneIcon}}" mode="aspectFit" />
    <view class="service-info">
      <view class="service-label">{{copy.phoneLabel}}</view>
      <view class="service-phone">{{servicePhone}}</view>
      <view class="service-hours">{{serviceHours}}</view>
    </view>
    <view class="service-call">{{copy.callNow}}</view>
  </view>

  <view class="safe-bottom"></view>
</view>
