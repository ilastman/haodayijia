.page {
  padding-bottom: 20rpx;
}

/* 头部 */
.profile {
  position: relative;
  padding: 60rpx 32rpx 44rpx;
  background: #FCF9F1;
  overflow: hidden;
}

.profile-bg {
  position: absolute;
  inset: 0;
  background: linear-gradient(150deg, #EDE4D2 0%, #F6F1E7 60%, #EFE5CF 100%);
}

.avatar {
  position: relative;
  width: 132rpx;
  height: 132rpx;
  border-radius: 50%;
  background: #FCF9F1;
  border: 6rpx solid #FCF9F1;
  box-shadow: 0 6rpx 20rpx rgba(138, 113, 82, 0.12);
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8A7152;
  font-size: 52rpx;
  font-weight: 500;
}

.nick {
  position: relative;
  margin-top: 20rpx;
  font-size: 36rpx;
  font-weight: 600;
  color: #443A2C;
}

.nick-row {
  position: relative;
  display: flex;
  align-items: center;
  margin-top: 16rpx;
}

.nick-input {
  flex: 1;
  height: 72rpx;
  background: rgba(255, 255, 255, 0.85);
  border: 2rpx solid #EBE3D3;
  border-radius: 36rpx;
  padding: 0 26rpx;
  font-size: 26rpx;
}

.nick-ph {
  color: #A79F8D;
}

.avatar-btn {
  margin-left: 16rpx;
  font-size: 24rpx;
  color: #8A7152;
  background: #FCF9F1;
  border: 2rpx solid #8A7152;
  border-radius: 32rpx;
  padding: 0 24rpx;
  height: 64rpx;
  line-height: 60rpx;
}

.avatar-btn::after {
  border: none;
}

.login-tip {
  position: relative;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #948D7D;
}

.login-btn {
  position: relative;
  margin-top: 26rpx;
  width: 320rpx;
  background: linear-gradient(135deg, #8A7152, #5F4B33);
  color: #FCF9F1;
  font-size: 28rpx;
  border-radius: 40rpx;
  height: 76rpx;
  line-height: 76rpx;
}

.login-btn::after {
  border: none;
}

.nick-tip {
  position: relative;
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8A7152;
}

/* 菜单 */
.menu {
  margin: 24rpx 24rpx 0;
  background: #FCF9F1;
  border-radius: 20rpx;
  overflow: hidden;
}

.menu-item {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 32rpx 28rpx;
  border-bottom: 2rpx solid #F1EBDE;
}

.menu-item:last-child {
  border-bottom: none;
}

.menu-label {
  font-size: 29rpx;
  color: #3D362A;
}

.menu-arrow {
  font-size: 36rpx;
  color: #BBB49F;
  line-height: 1;
}

/* 客服电话 */
.service {
  display: flex;
  align-items: center;
  margin: 24rpx 24rpx 0;
  background: linear-gradient(135deg, #8A7152, #5F4B33);
  border-radius: 20rpx;
  padding: 30rpx 28rpx;
}

.service-icon {
  width: 64rpx;
  height: 64rpx;
  filter: brightness(0) invert(1);
  margin-right: 22rpx;
}

.service-info {
  flex: 1;
}

.service-label {
  font-size: 22rpx;
  color: rgba(255, 255, 255, 0.75);
}

.service-phone {
  font-size: 36rpx;
  font-weight: 600;
  color: #FCF9F1;
  margin-top: 4rpx;
}

.service-hours {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-top: 4rpx;
}

.service-call {
  background: #FCF9F1;
  color: #8A7152;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 30rpx;
  padding: 14rpx 26rpx;
}

.staff-chip {
  margin: 24rpx 24rpx 0;
  display: inline-block;
  font-size: 22rpx;
  color: #B08A3E;
  background: #EFE5CF;
  border-radius: 10rpx;
  padding: 8rpx 18rpx;
}
