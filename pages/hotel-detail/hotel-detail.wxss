.page {
  background: #F6F1E7;
  padding-bottom: 20rpx;
}

/* 轮播 */
.gallery {
  width: 100%;
  height: 440rpx;
}

.gallery-img {
  width: 100%;
  height: 440rpx;
  display: block;
  background: #EDE5D6;
}

/* 基础信息 */
.base {
  background: #FCF9F1;
  border-radius: 0 0 28rpx 28rpx;
  padding: 30rpx 28rpx 32rpx;
  box-shadow: 0 6rpx 20rpx rgba(90, 82, 66, 0.04);
}

.base-title {
  font-size: 38rpx;
  font-weight: 600;
  color: #443A2C;
  line-height: 1.4;
}

.tags {
  margin-top: 16rpx;
}

.tag {
  display: inline-block;
  font-size: 22rpx;
  color: #8A7152;
  background: #EDE4D2;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  margin-right: 10rpx;
}

.intro {
  margin-top: 18rpx;
  font-size: 26rpx;
  color: #817A6A;
  line-height: 1.6;
}

/* 信息块 */
.block {
  background: #FCF9F1;
  border-radius: 24rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #443A2C;
  margin-bottom: 18rpx;
  position: relative;
  padding-left: 18rpx;
}

.block-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: #8A7152;
}

.pic {
  width: 100%;
  height: 320rpx;
  border-radius: 16rpx;
  display: block;
  background: #EDE5D6;
  margin-bottom: 20rpx;
}

.desc {
  font-size: 26rpx;
  color: #4A4A4A;
  line-height: 1.7;
}

/* 房型要点 */
.room {
  display: flex;
  margin-top: 14rpx;
}

.room-mark {
  width: 32rpx;
  color: #8A7152;
  font-weight: 600;
}

.room-text {
  flex: 1;
  font-size: 26rpx;
  color: #3D362A;
  line-height: 1.6;
}

/* 配套 chips */
.fac-chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  font-size: 23rpx;
  color: #6B6453;
  background: #F0EADB;
  border-radius: 26rpx;
  padding: 10rpx 24rpx;
  margin: 0 14rpx 14rpx 0;
}

/* 底部 */
.bottom-holder {
  height: 150rpx;
}

.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FCF9F1;
  padding: 18rpx 28rpx;
  padding-bottom: calc(18rpx + env(safe-area-inset-bottom));
  box-shadow: 0 -6rpx 20rpx rgba(90, 82, 66, 0.06);
}

.consult-btn {
  width: 100%;
  background: linear-gradient(135deg, #8A7152, #5F4B33);
  color: #FCF9F1;
  font-size: 30rpx;
  font-weight: 500;
  border-radius: 44rpx;
}