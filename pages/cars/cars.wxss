.page {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 头部 */
.head {
  background: linear-gradient(150deg, #4A4133, #5F4B33);
  padding: 44rpx 32rpx 40rpx;
  color: #FCF9F1;
}

.head-title {
  font-size: 42rpx;
  font-weight: 600;
}

.head-sub {
  font-size: 24rpx;
  color: rgba(255, 255, 255, 0.8);
  margin-top: 10rpx;
}

.head-search {
  display: flex;
  align-items: center;
  margin-top: 26rpx;
  background: rgba(255, 255, 255, 0.95);
  color: #948D7D;
  border-radius: 38rpx;
  height: 72rpx;
  padding: 0 28rpx;
  font-size: 25rpx;
}

.car-ic {
  width: 34rpx;
  height: 34rpx;
  margin-right: 12rpx;
  opacity: 0.6;
}

/* 列表 */
.list {
  padding: 24rpx 24rpx 0;
}

.car {
  display: flex;
  background: #FCF9F1;
  border-radius: 20rpx;
  overflow: hidden;
  box-shadow: 0 4rpx 20rpx rgba(90, 82, 66, 0.04);
  margin-bottom: 24rpx;
}

.car-img {
  width: 240rpx;
  height: 250rpx;
  flex-shrink: 0;
  background: #EDE5D6;
}

.car-info {
  flex: 1;
  padding: 22rpx;
  min-width: 0;
}

.car-name-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.car-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #443A2C;
  flex: 1;
  margin-right: 12rpx;
}

.car-type {
  font-size: 20rpx;
  color: #B08A3E;
  background: #EFE5CF;
  border-radius: 6rpx;
  padding: 4rpx 12rpx;
  flex-shrink: 0;
}

.car-meta {
  font-size: 23rpx;
  color: #948D7D;
  margin-top: 10rpx;
}

.tags {
  margin-top: 12rpx;
}

.car-price-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
}

.price {
  color: #A4653A;
  font-weight: 600;
}

.price-symbol {
  font-size: 22rpx;
}

.price-num {
  font-size: 38rpx;
}

.per {
  font-size: 20rpx;
  font-weight: 400;
  color: #948D7D;
}

.rent-btn {
  background: linear-gradient(135deg, #8A7152, #5F4B33);
  color: #FCF9F1;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 30rpx;
  padding: 12rpx 26rpx;
}

.tip {
  text-align: center;
  font-size: 22rpx;
  color: #ADA690;
  padding: 10rpx 40rpx 0;
}
