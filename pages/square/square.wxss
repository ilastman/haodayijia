.page {
  background: #F6F1E7;
  padding-bottom: 40rpx;
}

/* 顶部：纤细标题 + 极简圆形发布 */
.head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 44rpx 40rpx 10rpx;
}

.sq-title {
  font-size: 40rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  color: #3D362A;
}

.publish-circle {
  width: 92rpx;
  height: 92rpx;
  border-radius: 50%;
  border: 1rpx solid #C0B9A6;
  color: #817A6A;
  font-size: 24rpx;
  letter-spacing: 1rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  background: #F6F1E7;
}

/* 极简分类标签 */
.cat-scroll {
  white-space: nowrap;
  padding: 18rpx 40rpx 6rpx;
}

.cat {
  display: inline-block;
  font-size: 26rpx;
  color: #948D7D;
  padding: 10rpx 26rpx 14rpx;
  margin-right: 10rpx;
  border-bottom: 3rpx solid transparent;
}

.cat.on {
  color: #5F4B33;
  border-bottom-color: #8A7152;
}

/* 双列瀑布流 */
.feed {
  display: flex;
  align-items: flex-start;
  padding: 20rpx 28rpx 0;
}

.col {
  flex: 1;
  min-width: 0;
}

.col:first-child {
  margin-right: 24rpx;
}

.card {
  background: #FCF9F1;
  border-radius: 24rpx;
  overflow: hidden;
  margin-bottom: 28rpx;
}

.card-cover {
  position: relative;
}

.card-img {
  width: 100%;
  display: block;
  background: #EDE5D6;
}

.card-type {
  position: absolute;
  left: 16rpx;
  top: 16rpx;
  font-size: 20rpx;
  color: #5F4B33;
  background: rgba(252, 249, 241, 0.9);
  border-radius: 20rpx;
  padding: 6rpx 18rpx;
  letter-spacing: 1rpx;
}

.card-type.note {
  color: #A4653A;
}

.card-body {
  padding: 18rpx 20rpx 20rpx;
}

.card-title {
  font-size: 28rpx;
  font-weight: 400;
  color: #3D362A;
  line-height: 1.5;
}

.card-foot {
  display: flex;
  align-items: center;
  margin-top: 16rpx;
  min-width: 0;
}

.card-avatar {
  width: 40rpx;
  height: 40rpx;
  border-radius: 50%;
  background: #EDE5D6;
  flex-shrink: 0;
}

.card-name {
  font-size: 22rpx;
  color: #A79F8D;
  margin-left: 12rpx;
  flex: 1;
  min-width: 0;
}

.card-like {
  display: flex;
  align-items: center;
  flex-shrink: 0;
  margin-left: 10rpx;
  padding: 4rpx 0 4rpx 10rpx;
}

.card-heart {
  font-size: 26rpx;
  color: #C0B9A6;
  line-height: 1;
}

.card-heart.on {
  color: #A4653A;
}

.card-num {
  font-size: 21rpx;
  color: #A79F8D;
  margin-left: 6rpx;
}

/* 空态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 120rpx 0;
  color: #A79F8D;
  font-size: 26rpx;
}

.empty-icon {
  font-size: 72rpx;
  margin-bottom: 16rpx;
}