.page {
  background: #F6F1E7;
  padding-bottom: 20rpx;
}

/* ============ A. 杂志种草区 ============ */

/* 第一屏 16:9 主视觉 */
.hero {
  position: relative;
  width: 100%;
  height: 422rpx;
  overflow: hidden;
}

.hero-img {
  width: 100%;
  height: 100%;
  display: block;
  background: #EDE5D6;
}

.hero-mask {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  background: linear-gradient(180deg, rgba(67, 56, 40, 0.22) 0%, rgba(67, 56, 40, 0) 38%, rgba(47, 39, 28, 0.42) 100%);
}

.hero-caption {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 48rpx;
}

.hero-title {
  color: #FFFFFF;
  font-size: 40rpx;
  font-weight: 300;
  letter-spacing: 4rpx;
  line-height: 1.45;
  text-align: center;
  text-shadow: 0 2rpx 12rpx rgba(30, 24, 16, 0.4);
}

.hero-slogan {
  margin-top: 22rpx;
  color: rgba(255, 255, 255, 0.82);
  font-size: 23rpx;
  font-weight: 300;
  letter-spacing: 6rpx;
  text-align: center;
}

/* 第二屏 大留白叙事 */
.story {
  padding: 48rpx 56rpx 20rpx;
}

.story-note {
  font-size: 27rpx;
  color: #4A4A4A;
  font-weight: 300;
  line-height: 1.95;
  letter-spacing: 1rpx;
}

.story-labels {
  margin-top: 48rpx;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
  justify-content: center;
}

.story-label {
  font-size: 23rpx;
  color: #948D7D;
  letter-spacing: 3rpx;
}

.story-label + .story-label::before {
  content: "·";
  margin: 0 26rpx;
  color: #C9C0AC;
}

/* 第三屏 4 张风景小图 + 权益 */
.perks {
  padding: 8rpx 40rpx 48rpx;
}

.perk {
  margin-top: 52rpx;
}

.perk:first-child {
  margin-top: 0;
}

.perk-img {
  width: 100%;
  height: 302rpx;
  display: block;
  border-radius: 16rpx;
  background: #EDE5D6;
}

.perk-text {
  margin-top: 20rpx;
  padding: 0 8rpx;
  font-size: 26rpx;
  color: #4A4A4A;
  font-weight: 300;
  line-height: 1.75;
  letter-spacing: 1rpx;
}

/* 分区过渡 */
.zone-line {
  margin: 0rpx 40rpx 4rpx;
  border-top: 1rpx solid #E1D7C2;
}

/* ============ B. 专业行程区 ============ */

.detail-zone {
  margin-top: 8rpx;
}

/* 基础行程信息栏 */
.info-bar {
  display: flex;
  margin: 4rpx 48rpx 2rpx;
  padding: 8rpx 0;
}

.info-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 12rpx 0;
}

.info-item:not(:last-child) {
  border-right: 1rpx solid #E9E0CE;
}

.info-k {
  display: block;
  font-size: 20rpx;
  color: #B0A997;
  letter-spacing: 2rpx;
}

.info-v {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5F4B33;
  letter-spacing: 1rpx;
}

/* 通用块 */
.block {
  background: #FCF9F1;
  border-radius: 20rpx;
  margin: 16rpx 24rpx 0;
  padding: 24rpx 26rpx;
}

.block-title {
  font-size: 30rpx;
  font-weight: 400;
  letter-spacing: 3rpx;
  color: #443A2C;
  margin-bottom: 22rpx;
}

/* 每日行程沉浸式 */
.rd-block {
  padding-bottom: 4rpx;
}

.rd-head {
  display: flex;
  align-items: center;
  margin-bottom: 14rpx;
}

.rd-arrow {
  flex-shrink: 0;
  width: 56rpx;
  height: 56rpx;
  line-height: 52rpx;
  text-align: center;
  border-radius: 50%;
  background: #F6F1E7;
  color: #8A7152;
  font-size: 40rpx;
}

.rd-arrow.disabled {
  color: #CFC7B4;
}

.rd-tabs {
  flex: 1;
  margin: 0 12rpx;
  white-space: nowrap;
}

.rd-row {
  display: inline-flex;
  gap: 12rpx;
}

.rd-tab {
  display: inline-block;
  padding: 12rpx 26rpx;
  border-radius: 32rpx;
  background: #F6F1E7;
  color: #948D7D;
  font-size: 25rpx;
  transition: all .2s;
}

.rd-tab.on {
  background: linear-gradient(135deg, #8A7152, #5F4B33);
  color: #FCF9F1;
  font-weight: 500;
}

.rd-swiper {
  height: 2078rpx;
}

/* 各线路按实际渲染高度收紧 swiper 预留区，消除贴心提示下方多余空白 */
.rd-swiper-r001 { height: 1840rpx; }
.rd-swiper-r002 { height: 1680rpx; }
.rd-swiper-r003 { height: 1600rpx; }
.rd-swiper-r004 { height: 1480rpx; }
.rd-swiper-r005 { height: 1440rpx; }
.rd-swiper-r006 { height: 1600rpx; }
.rd-swiper-r007 { height: 1600rpx; }
.rd-swiper-r008 { height: 1360rpx; }

.rd-cell {
  padding: 0 2rpx 2rpx;
}

.rd-scene-line {
  font-size: 24rpx;
  color: #8A7152;
  letter-spacing: 2rpx;
  padding: 4rpx 10rpx 2rpx;
}

.rd-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx 20rpx;
  padding: 10rpx 10rpx 4rpx;
}

.rd-tag {
  font-size: 23rpx;
  color: #948D7D;
  letter-spacing: 1rpx;
}

/* 时间线 */
.rd-timeline {
  margin-top: 4rpx;
}

.rd-node {
  position: relative;
  padding: 8rpx 0 16rpx 24rpx;
}

.rd-line {
  display: flex;
  align-items: flex-start;
}

.rd-dot {
  position: absolute;
  left: 0;
  top: 30rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #C6A870;
  box-shadow: 0 0 0 6rpx rgba(198, 168, 112, 0.18);
}

.rd-thumb-box {
  flex-shrink: 0;
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  overflow: hidden;
  margin-right: 20rpx;
  background: #EDE5D6;
}

.rd-thumb {
  width: 150rpx;
  height: 150rpx;
  display: block;
}

.rd-main {
  flex: 1;
  min-width: 0;
  padding-top: 4rpx;
}

.rd-time {
  display: block;
  font-size: 24rpx;
  color: #B08A3E;
  font-weight: 400;
  letter-spacing: 1rpx;
}

.rd-text {
  margin-top: 8rpx;
  font-size: 27rpx;
  color: #4A4A4A;
  line-height: 1.7;
}

.rd-link {
  color: #8A7152;
  font-weight: 400;
  border-bottom: 2rpx dashed rgba(138, 113, 82, 0.45);
}

/* 今日专属体验 / 卡片通用 */
.rd-perks {
  padding: 6rpx 0 2rpx;
}

.rd-title {
  font-size: 24rpx;
  color: #A08A68;
  letter-spacing: 3rpx;
  margin-bottom: 16rpx;
  padding-left: 16rpx;
  position: relative;
}

.rd-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 6rpx;
  bottom: 6rpx;
  width: 6rpx;
  border-radius: 3rpx;
  background: #C6A870;
}

.rd-item {
  display: flex;
  align-items: flex-start;
  margin-bottom: 8rpx;
}

.rd-mark {
  flex-shrink: 0;
  color: #C6A870;
  font-size: 18rpx;
  margin: 8rpx 12rpx 0 0;
}

.rd-item-text {
  font-size: 26rpx;
  color: #5B5344;
  line-height: 1.65;
}

.rd-card {
  background: #F6F1E7;
  border-radius: 18rpx;
  padding: 16rpx 22rpx 14rpx;
  margin-top: 6rpx;
}

.rd-card .rd-title {
  margin-bottom: 12rpx;
}

.rd-note-line {
  font-size: 26rpx;
  color: #5B5344;
  line-height: 1.7;
}

/* 当日住宿 */
.rd-s-card {
  display: flex;
  align-items: flex-start;
}

.rd-s-img {
  flex-shrink: 0;
  width: 168rpx;
  height: 118rpx;
  border-radius: 12rpx;
  background: #EDE5D6;
  margin-right: 20rpx;
}

.rd-s-main {
  flex: 1;
  min-width: 0;
}

.rd-s-name {
  font-size: 29rpx;
  font-weight: 500;
  color: #3D362A;
}

.rd-s-note {
  display: block;
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #817A6A;
  line-height: 1.6;
}

/* ============ C. 页尾商业化区 ============ */

.commercial {
  padding: 20rpx 44rpx 0;
}

.ref-price {
  text-align: center;
  padding: 12rpx 0 24rpx;
}

.ref-label {
  display: block;
  font-size: 22rpx;
  color: #ADA690;
  letter-spacing: 4rpx;
  margin-bottom: 14rpx;
}

.ref-num {
  font-size: 34rpx;
  color: #A4653A;
  font-weight: 400;
}

.ref-per {
  font-size: 22rpx;
  color: #948D7D;
}

.ref-old {
  font-size: 20rpx;
  color: #B0A997;
  text-decoration: line-through;
  margin-left: 14rpx;
}

.sec {
  margin-bottom: 24rpx;
}

.sec-title {
  font-size: 27rpx;
  color: #443A2C;
  letter-spacing: 3rpx;
  margin-bottom: 18rpx;
}

.sec-sub {
  font-size: 24rpx;
  color: #8A7152;
  letter-spacing: 1rpx;
  margin: 14rpx 0 8rpx;
}

.sec-item {
  font-size: 24rpx;
  color: #817A6A;
  line-height: 1.75;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.sec-chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  background: #F1EBDD;
  color: #8A7152;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  margin: 6rpx 12rpx 0 0;
}

/* 游客评价 */
.review {
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F1EBDE;
}

.review:last-child {
  border-bottom: none;
  padding-bottom: 0;
}

.review-head {
  display: flex;
  align-items: center;
}

.review-avatar {
  width: 56rpx;
  height: 56rpx;
  border-radius: 50%;
  background: #EDE4D2;
  color: #8A7152;
  font-size: 24rpx;
  font-weight: 400;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-right: 16rpx;
}

.review-name {
  font-size: 26rpx;
  font-weight: 400;
  color: #3D362A;
  flex: 1;
}

.review-stars {
  color: #E8A23A;
  font-size: 22rpx;
}

.review-date {
  font-size: 21rpx;
  color: #ADA690;
  margin: 8rpx 0 0 72rpx;
}

.review-content {
  font-size: 25rpx;
  color: #4A4A4A;
  line-height: 1.7;
  margin: 10rpx 0 0 72rpx;
}

/* 细描边预约按钮 */
.consult-line-btn {
  display: block;
  width: 88%;
  margin: 16rpx auto 0;
  height: 84rpx;
  line-height: 82rpx;
  text-align: center;
  font-size: 27rpx;
  letter-spacing: 4rpx;
  color: #5F4B33;
  background: transparent;
  border: 1rpx solid #8A7152;
  border-radius: 44rpx;
  font-weight: 400;
  box-sizing: border-box;
}

.consult-line-btn::after {
  border: none;
}

.bottom-space {
  height: 24rpx;
  padding-bottom: env(safe-area-inset-bottom);
}