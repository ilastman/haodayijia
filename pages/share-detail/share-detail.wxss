.page {
  background: #F6F1E7;
  padding-bottom: 200rpx;
}

/* 通栏封面 */
.cover {
  width: 100%;
  display: block;
}

/* 留白区 + 精简文字 */
.base {
  padding: 56rpx 40rpx 12rpx;
}

.p-title {
  font-size: 36rpx;
  font-weight: 400;
  letter-spacing: 1rpx;
  color: #3D362A;
  line-height: 1.55;
}

.p-meta {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
}

.p-tag {
  font-size: 22rpx;
  color: #817A6A;
  margin-right: 24rpx;
  letter-spacing: 1rpx;
}

.p-tag.season {
  color: #9A7B4F;
}

.p-author {
  display: flex;
  align-items: center;
  margin-top: 30rpx;
}

.p-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #EDE5D6;
}

.p-name {
  font-size: 24rpx;
  color: #5D5547;
  margin-left: 14rpx;
}

.p-time {
  font-size: 22rpx;
  color: #A79F8D;
  margin-left: 16rpx;
}

/* 内容块 */
.block {
  padding: 46rpx 40rpx 0;
}

.block-title {
  font-size: 26rpx;
  font-weight: 500;
  letter-spacing: 4rpx;
  color: #9A7B4F;
  margin-bottom: 26rpx;
}

/* 亮点 */
.hl {
  display: flex;
  align-items: flex-start;
  margin-bottom: 20rpx;
}

.hl-mark {
  color: #C0B9A6;
  font-size: 24rpx;
  margin-right: 16rpx;
  line-height: 1.55;
}

.hl-text {
  flex: 1;
  font-size: 25rpx;
  color: #5D5547;
  line-height: 1.6;
}

/* 每日时间线 */
.day {
  position: relative;
  padding-left: 34rpx;
  margin-bottom: 44rpx;
}

.day-head {
  display: flex;
  align-items: center;
  margin-bottom: 18rpx;
}

.day-dot {
  position: absolute;
  left: 0;
  top: 4rpx;
  width: 14rpx;
  height: 14rpx;
  border-radius: 50%;
  background: #C0B9A6;
}

.day-title {
  font-size: 27rpx;
  font-weight: 500;
  color: #3D362A;
  letter-spacing: 1rpx;
}

.day-card {
  display: flex;
  align-items: flex-start;
}

.day-thumb {
  width: 150rpx;
  height: 150rpx;
  border-radius: 16rpx;
  background: #EDE5D6;
  flex-shrink: 0;
}

.day-info {
  flex: 1;
  min-width: 0;
  margin-left: 22rpx;
}

.day-scenics {
  display: flex;
  flex-wrap: wrap;
  flex-direction: row;
  align-items: center;
  margin-bottom: 14rpx;
}

.day-chip {
  font-size: 22rpx;
  color: #5D5547;
  background: #F1EADA;
  border-radius: 18rpx;
  padding: 6rpx 18rpx;
  margin: 0 12rpx 10rpx 0;
}

.day-line {
  display: flex;
  align-items: baseline;
  margin-bottom: 10rpx;
}

.day-label {
  font-size: 22rpx;
  color: #A79F8D;
  flex-shrink: 0;
  margin-right: 14rpx;
}

.day-value {
  font-size: 24rpx;
  color: #5D5547;
  line-height: 1.5;
}

.day-value.note {
  color: #817A6A;
}

/* 评论区 */
.comments-title {
  margin-top: 6rpx;
}

.comment {
  display: flex;
  align-items: flex-start;
  padding: 24rpx 0;
  border-bottom: 1rpx solid #EDE6D6;
}

.comment:last-of-type {
  border-bottom: none;
}

.c-avatar {
  width: 48rpx;
  height: 48rpx;
  border-radius: 50%;
  background: #EDE5D6;
  flex-shrink: 0;
}

.c-body {
  flex: 1;
  min-width: 0;
  margin-left: 18rpx;
}

.c-name {
  display: block;
  font-size: 23rpx;
  color: #9A7B4F;
}

.c-text {
  display: block;
  font-size: 25rpx;
  color: #5D5547;
  line-height: 1.5;
  margin: 8rpx 0;
}

.c-likes {
  font-size: 20rpx;
  color: #C0B9A6;
}

.no-comment {
  font-size: 24rpx;
  color: #A79F8D;
  padding: 24rpx 0;
  text-align: center;
}

/* 底部互动栏 */
.bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  z-index: 40;
  height: 108rpx;
  background: #FCF9F1;
  border-top: 1rpx solid #EDE6D6;
  display: flex;
  align-items: center;
  padding: 0 24rpx;
  box-sizing: border-box;
}

.bar-input {
  flex: 1;
  min-width: 0;
  height: 62rpx;
  background: #F1EADA;
  border-radius: 31rpx;
  padding: 0 28rpx;
  font-size: 26rpx;
  color: #3D362A;
}

.ph {
  color: #BDB6A2;
}

.act {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 0 16rpx;
}

.act-ico {
  font-size: 34rpx;
  color: #C0B9A6;
  line-height: 1;
}

.act-label {
  font-size: 19rpx;
  color: #A79F8D;
  margin-top: 4rpx;
}

.act.on .act-ico {
  color: #A4653A;
}

.act.on .act-label {
  color: #A4653A;
}

/* 悬浮定制按钮 */
.cta {
  position: fixed;
  bottom: 128rpx;
  right: 32rpx;
  z-index: 39;
  background: #5F4B33;
  color: #FBF7EF;
  font-size: 26rpx;
  letter-spacing: 2rpx;
  border-radius: 40rpx;
  padding: 20rpx 32rpx;
  box-shadow: 0 8rpx 20rpx rgba(95, 75, 51, 0.2);
}