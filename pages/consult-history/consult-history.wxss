.page {
  padding-top: 24rpx;
  min-height: 100vh;
}

.list {
  padding: 0 24rpx;
}

.rec-card {
  background: #FCF9F1;
  border-radius: 20rpx;
  box-shadow: 0 4rpx 20rpx rgba(90, 82, 66, 0.04);
  padding: 26rpx;
  margin-bottom: 24rpx;
}

.rec-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.rec-name {
  font-size: 30rpx;
  font-weight: 600;
  color: #443A2C;
}

.rec-time {
  font-size: 22rpx;
  color: #ADA690;
}

.rec-route {
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #8A7152;
  background: #EDE4D2;
  display: inline-block;
  border-radius: 8rpx;
  padding: 6rpx 14rpx;
}

.rec-rows {
  margin-top: 18rpx;
}

.rec-row {
  display: flex;
  font-size: 25rpx;
  line-height: 1.7;
  margin-bottom: 6rpx;
}

.rec-row .k {
  width: 140rpx;
  color: #948D7D;
  flex-shrink: 0;
}

.rec-row .v {
  flex: 1;
  color: #4A4A4A;
  word-break: break-all;
}

.rec-foot {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 16rpx;
  padding-top: 18rpx;
  border-top: 2rpx solid #F1EBDE;
}

.rec-status {
  font-size: 24rpx;
  color: #E8A23A;
}

.rec-call {
  font-size: 24rpx;
  color: #8A7152;
  border: 2rpx solid #8A7152;
  border-radius: 26rpx;
  padding: 8rpx 24rpx;
}
