.page {
  min-height: 100vh;
  padding-bottom: 20rpx;
}

/* 品牌头 */
.brand-head {
  background: linear-gradient(150deg, #EDE4D2 0%, #F6F1E7 60%, #EFE5CF 100%);
  padding: 70rpx 32rpx 60rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.brand-logo {
  width: 130rpx;
  height: 130rpx;
  border-radius: 32rpx;
  background: linear-gradient(135deg, #8A7152, #5F4B33);
  color: #FCF9F1;
  font-size: 60rpx;
  font-weight: 600;
  display: flex;
  align-items: center;
  justify-content: center;
  box-shadow: 0 10rpx 30rpx rgba(95, 75, 51, 0.16);
}

.brand-name {
  margin-top: 26rpx;
  font-size: 38rpx;
  font-weight: 600;
  color: #443A2C;
}

.brand-slogan {
  margin-top: 10rpx;
  font-size: 24rpx;
  color: #948D7D;
}

/* 块 */
.block {
  background: #FCF9F1;
  border-radius: 20rpx;
  margin: 24rpx 24rpx 0;
  padding: 30rpx 28rpx;
}

.block-title {
  font-size: 32rpx;
  font-weight: 600;
  color: #443A2C;
  padding-left: 16rpx;
  position: relative;
  margin-bottom: 22rpx;
}

.block-title::before {
  content: "";
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: linear-gradient(180deg, #8A7152, #C6A870);
}

.para {
  font-size: 27rpx;
  color: #4A4A4A;
  line-height: 1.85;
  margin-bottom: 18rpx;
}

.intro {
  color: #817A6A;
  background: #F6F1E7;
  border-radius: 14rpx;
  padding: 20rpx;
  margin-bottom: 0;
  font-size: 25rpx;
}

/* 联系 */
.contact {
  display: flex;
  align-items: center;
  background: linear-gradient(135deg, #8A7152, #5F4B33);
  border-radius: 18rpx;
  padding: 26rpx 24rpx;
}

.c-icon {
  width: 56rpx;
  height: 56rpx;
  filter: brightness(0) invert(1);
  margin-right: 20rpx;
}

.c-info {
  flex: 1;
}

.c-label {
  font-size: 22rpx;
  color: #948D7D;
}

.contact .c-label {
  color: rgba(255, 255, 255, 0.75);
}

.c-value {
  font-size: 36rpx;
  font-weight: 600;
  color: #FCF9F1;
  margin-top: 4rpx;
}

.c-sub {
  font-size: 20rpx;
  color: rgba(255, 255, 255, 0.65);
  margin-top: 4rpx;
}

.c-action {
  background: #FCF9F1;
  color: #8A7152;
  font-size: 24rpx;
  font-weight: 500;
  border-radius: 30rpx;
  padding: 14rpx 26rpx;
}

.c-line {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 26rpx 4rpx;
  border-bottom: 2rpx solid #F1EBDE;
}

.c-line:last-child {
  border-bottom: none;
}

.c-line-right {
  display: flex;
  align-items: center;
}

.c-value-sm {
  font-size: 27rpx;
  color: #3D362A;
  margin-right: 20rpx;
}

.c-addr {
  flex: 1;
  text-align: right;
  color: #817A6A;
  font-size: 24rpx;
}

.c-copy {
  font-size: 22rpx;
  color: #8A7152;
  border: 2rpx solid #8A7152;
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
}

.copyright {
  text-align: center;
  font-size: 22rpx;
  color: #BBB49F;
  margin-top: 40rpx;
}
