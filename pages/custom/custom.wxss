.page {
  padding-bottom: 40rpx;
}

/* 头部 */
.head {
  padding: 30rpx 24rpx 10rpx;
}

.head-title {
  font-size: 40rpx;
  font-weight: 600;
  color: #3D362A;
}

.head-sub {
  margin-top: 8rpx;
  font-size: 24rpx;
  color: #9E9886;
}

/* 卡片 */
.card {
  background: #FCF9F1;
  border-radius: 24rpx;
  margin: 24rpx 24rpx 0;
  padding: 28rpx;
  box-shadow: 0 4rpx 16rpx rgba(90, 82, 66, 0.03);
}

.card-title {
  font-size: 30rpx;
  font-weight: 500;
  color: #443A2C;
  margin-bottom: 20rpx;
  position: relative;
  padding-left: 18rpx;
}

.card-title::before {
  content: '';
  position: absolute;
  left: 0;
  top: 8rpx;
  bottom: 8rpx;
  width: 8rpx;
  border-radius: 4rpx;
  background: #8A7152;
}

/* 行 */
.row {
  display: flex;
  align-items: center;
  padding: 12rpx 0;
}

.row-label {
  width: 170rpx;
  flex-shrink: 0;
  font-size: 26rpx;
  color: #4A4A4A;
}

/* 天数 chips */
.chips {
  display: flex;
  flex: 1;
  flex-wrap: wrap;
}

.chip {
  font-size: 24rpx;
  color: #817A6A;
  background: #F2ECDF;
  border-radius: 30rpx;
  padding: 10rpx 28rpx;
  margin-right: 14rpx;
  margin-top: 6rpx;
}

.chip.on {
  background: #8A7152;
  color: #FCF9F1;
  font-weight: 500;
}

/* 选车弹层 chips 复用 .sheet-cats / .sheet-chip（与选择酒店同款） */

.custom-days {
  flex: 1;
  display: flex;
  align-items: center;
}

.days-input {
  width: 120rpx;
  height: 60rpx;
  background: #F2ECDF;
  border-radius: 12rpx;
  text-align: center;
  font-size: 26rpx;
  color: #3D362A;
}

.days-unit {
  margin-left: 12rpx;
  font-size: 26rpx;
  color: #817A6A;
}

/* 日期 */
.field-input {
  flex: 1;
  min-height: 60rpx;
  line-height: 60rpx;
  background: #F2ECDF;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #3D362A;
}

.ph {
  color: #A79F8D;
}

/* 步进器 */
.steppers {
  flex: 1;
  display: flex;
  align-items: center;
}

.stepper-sub {
  margin-left: 30rpx;
}

.stepper {
  display: flex;
  align-items: center;
}

.stepper-label {
  font-size: 26rpx;
  color: #4A4A4A;
  margin-right: 14rpx;
}

.stepper-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 32rpx;
  color: #8A7152;
  background: #EDE4D2;
  border-radius: 12rpx;
}

.stepper-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #3D362A;
}

/* 每日标签 */
.day-scroll {
  white-space: nowrap;
  padding: 26rpx 24rpx 4rpx;
}

.day-chip {
  display: inline-block;
  font-size: 26rpx;
  color: #817A6A;
  background: #FCF9F1;
  border-radius: 30rpx;
  padding: 12rpx 34rpx;
  margin-right: 16rpx;
}

.day-chip.on {
  background: #8A7152;
  color: #FCF9F1;
  font-weight: 500;
}

/* 添加按钮 */
.add-btn {
  display: inline-block;
  font-size: 26rpx;
  color: #8A7152;
  background: #EDE4D2;
  border-radius: 14rpx;
  padding: 14rpx 30rpx;
  margin-bottom: 18rpx;
}

.img-actions {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.upload-slots {
  display: flex;
  flex-wrap: wrap;
  margin-top: 16rpx;
}

.upload-slot {
  width: 240rpx;
  margin: 0 24rpx 12rpx 0;
}

.upload-plus {
  width: 120rpx;
  height: 120rpx;
  line-height: 112rpx;
  text-align: center;
  font-size: 48rpx;
  color: #8A7152;
  background: #EDE4D2;
  border-radius: 16rpx;
}

.upload-hint {
  display: block;
  margin-top: 10rpx;
  font-size: 24rpx;
  font-weight: 500;
  color: #3D362A;
}

.upload-sub {
  display: block;
  margin-top: 4rpx;
  font-size: 22rpx;
  line-height: 1.4;
  color: #8A7152;
}

.img-btn {
  display: inline-block;
  font-size: 26rpx;
  color: #8A7152;
  background: #EDE4D2;
  border-radius: 14rpx;
  padding: 14rpx 30rpx;
  margin: 0 16rpx 8rpx 0;
}

.info-bar {
  display: flex;
  margin: 0 24rpx 20rpx;
  padding: 8rpx 0 4rpx;
  background: #FCF9F1;
  border-radius: 16rpx;
}

.info-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 12rpx 6rpx;
}

.info-item:not(:last-child) {
  border-right: 1rpx solid #E9E0CE;
}

.info-k {
  display: block;
  font-size: 20rpx;
  color: #B0A997;
  letter-spacing: 1rpx;
}

.info-v,
.info-input {
  display: block;
  width: 100%;
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #5F4B33;
  text-align: center;
  background: transparent;
}

.info-input {
  height: 40rpx;
  line-height: 40rpx;
}

.cover-row, .promo-row {
  display: flex;
  flex-wrap: wrap;
  align-items: flex-start;
  margin-top: 12rpx;
}

.cover-preview {
  width: 100%;
  height: 280rpx;
  border-radius: 16rpx;
  display: block;
  background: #EDE4D2;
}

.cover-row .op-btn {
  margin-top: 12rpx;
}

.promo-cell {
  width: 220rpx;
  margin: 0 16rpx 12rpx 0;
}

.promo-img {
  width: 220rpx;
  height: 140rpx;
  border-radius: 12rpx;
  display: block;
  background: #EDE4D2;
}

.opt-thumb {
  width: 120rpx;
  height: 80rpx;
  border-radius: 10rpx;
  margin-right: 16rpx;
  flex: 0 0 120rpx;
  background: #EDE4D2;
}

/* 已选列表 */
.sel-list {
  border-top: 1rpx solid #F0EADB;
}

.sel-item {
  display: flex;
  flex-direction: column;
  align-items: stretch;
  min-height: 116rpx;
  border-bottom: 1rpx solid #F0EADB;
  position: relative;
  z-index: 0;
  background: #FCF9F1;
  overflow: visible;
  padding-bottom: 12rpx;
  box-sizing: border-box;
}

.sel-row {
  display: flex;
  align-items: center;
  min-height: 116rpx;
  position: relative;
  z-index: 1;
}

.sel-list.live .sel-item {
  transition: transform 0.12s ease;
}

.sel-list.live .sel-item.dragging {
  transition: none;
  z-index: 5;
  background: #F6F1E6;
  border-radius: 14rpx;
  box-shadow: 0 10rpx 28rpx rgba(61, 54, 42, 0.16);
}

.sel-item.drop-on {
  background: #F3EDDF;
}

.drag-handle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  width: 72rpx;
  height: 116rpx;
  margin-left: -8rpx;
  touch-action: none;
}

.sel-order {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #8A7152;
  color: #FCF9F1;
  font-size: 24rpx;
  font-weight: 500;
  flex-shrink: 0;
}

.sel-body {
  flex: 1;
  min-width: 0;
  padding: 0 18rpx;
}

.sel-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #3D362A;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.sel-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9E9886;
}

.sel-ops {
  display: flex;
  align-items: center;
  flex-shrink: 0;
}

.op-btn {
  font-size: 22rpx;
  color: #8A7152;
  background: #EDE4D2;
  border-radius: 10rpx;
  padding: 8rpx 16rpx;
  margin-left: 10rpx;
}

.op-btn.del {
  color: #C25A3A;
  background: #FCEFE9;
}

.sel-empty {
  font-size: 24rpx;
  color: #A79F8D;
  padding: 16rpx 0;
}

.hotel-sel {
  display: flex;
  align-items: center;
  background: #F3EDDF;
  border-radius: 14rpx;
  padding: 20rpx;
}

.hotel-sel .op-btn {
  margin-left: 14rpx;
}

.hotel-cover {
  width: 150rpx;
  height: 100rpx;
  border-radius: 12rpx;
  flex-shrink: 0;
  background: #EDE5D6;
}

.car-note {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #8A8070;
}

/* 同级备选：按钮打开选择面板，已选酒店用与主酒店相同的卡片 */
.alt-block {
  margin-top: 18rpx;
}

.alt-title {
  font-size: 24rpx;
  color: #8A7152;
  margin-bottom: 10rpx;
}

.alt-block .add-btn {
  margin-bottom: 14rpx;
}

.alt-sel {
  margin-bottom: 14rpx;
}

.tip-line {
  margin-top: 12rpx;
  font-size: 22rpx;
  color: #ACA48F;
}

/* 备注 */
.note {
  width: 100%;
  min-height: 140rpx;
  background: #F3EDDF;
  border-radius: 14rpx;
  padding: 20rpx;
  font-size: 26rpx;
  color: #3D362A;
  line-height: 1.6;
}

/* 底部提交栏 */
.bottom-bar {
  position: fixed;
  left: 0;
  right: 0;
  bottom: 0;
  background: #FCF9F1;
  display: flex;
  align-items: center;
  padding: 16rpx 24rpx;
  box-shadow: 0 -6rpx 24rpx rgba(90, 82, 66, 0.06);
  z-index: 100;
}

.summary {
  flex: 1;
  display: flex;
}

.sum-item {
  font-size: 26rpx;
  color: #3D362A;
  font-weight: 500;
  margin-right: 24rpx;
}

.publish-btn {
  color: #8A7152;
  background: #EDE4D2;
  font-size: 26rpx;
  font-weight: 500;
  border: 2rpx solid #8A7152;
  border-radius: 42rpx;
  padding: 18rpx 30rpx;
  margin-right: 16rpx;
  flex-shrink: 0;
}

.submit-btn {
  background: linear-gradient(135deg, #8A7152, #5F4B33);
  color: #FCF9F1;
  font-size: 28rpx;
  font-weight: 500;
  border-radius: 42rpx;
  padding: 20rpx 44rpx;
}

.submit-btn.is-busy {
  opacity: 0.55;
}

.submit-btn.full {
  width: 100%;
  text-align: center;
  border-radius: 14rpx;
  margin-top: 20rpx;
}

/* 弹层面板 */
.sheet-mask {
  position: fixed;
  inset: 0;
  background: rgba(60, 50, 38, 0.4);
  z-index: 900;
  display: flex;
  align-items: flex-end;
  justify-content: center;
}

.sheet {
  width: 100%;
  background: #FCF9F1;
  border-radius: 28rpx 28rpx 0 0;
  padding-bottom: 20rpx;
  max-height: 76%;
  display: flex;
  flex-direction: column;
}

.sheet-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 28rpx 28rpx 16rpx;
  gap: 12rpx;
}

.sheet-title {
  flex-shrink: 0;
  font-size: 32rpx;
  font-weight: 600;
  color: #3D362A;
}

.sheet-search-wrap {
  flex: 1;
  min-width: 0;
  position: relative;
  display: flex;
  align-items: center;
}

.sheet-search {
  width: 100%;
  height: 56rpx;
  line-height: 56rpx;
  background: #F2ECDF;
  border-radius: 28rpx;
  padding: 0 52rpx 0 24rpx;
  font-size: 24rpx;
  color: #3D362A;
  box-sizing: border-box;
}

.sheet-search-clear {
  position: absolute;
  right: 8rpx;
  top: 50%;
  transform: translateY(-50%);
  width: 40rpx;
  height: 40rpx;
  line-height: 40rpx;
  text-align: center;
  font-size: 28rpx;
  color: #817A6A;
  border-radius: 50%;
}

.sheet-confirm {
  flex-shrink: 0;
  font-size: 26rpx;
  color: #8A7152;
  font-weight: 500;
}

.guest-input {
  flex: 1;
  min-height: 60rpx;
  line-height: 60rpx;
  background: #F2ECDF;
  border-radius: 12rpx;
  padding: 0 24rpx;
  font-size: 26rpx;
  color: #3D362A;
}

.quote-inner-title {
  margin-top: 28rpx;
}

.sheet-cats {
  white-space: nowrap;
  padding: 0 8rpx 8rpx;
  position: relative;
  z-index: 2;
  background: #FCF9F1;
  flex-shrink: 0;
}

.sheet-chip {
  display: inline-block;
  margin: 0 12rpx 8rpx 0;
  padding: 8rpx 22rpx;
  border-radius: 24rpx;
  font-size: 24rpx;
  color: #817A6A;
  background: #F3EDDF;
}

.sheet-chip.on {
  color: #FCF9F1;
  background: #8A7152;
}

.sheet-list {
  height: 560rpx;
  max-height: 60vh;
  flex-shrink: 0;
  overflow: hidden;
}

.opt {
  display: flex;
  align-items: center;
  padding: 22rpx 28rpx;
  border-bottom: 1rpx solid #F0EADB;
}

.opt.on {
  background: #F1EADD;
}

.opt.on .opt-name {
  color: #8A7152;
}

.opt-body {
  flex: 1;
  min-width: 0;
}

.opt-name {
  font-size: 28rpx;
  color: #3D362A;
}

.opt-sub {
  margin-top: 6rpx;
  font-size: 22rpx;
  color: #9E9886;
}

.opt-check {
  width: 44rpx;
  height: 44rpx;
  line-height: 44rpx;
  text-align: center;
  border-radius: 50%;
  background: #EDE4D2;
  color: #8A7152;
  font-size: 26rpx;
  font-weight: 600;
  flex-shrink: 0;
}

/* 提交表单 */
.form-sheet {
  padding: 0 28rpx 30rpx;
}

.field {
  margin-top: 22rpx;
}

.label {
  font-size: 25rpx;
  color: #4A4A4A;
  margin-bottom: 10rpx;
}

.req {
  color: #A4653A;
  margin-left: 4rpx;
}

.input {
  width: 100%;
  height: 78rpx;
  background: #F3EDDF;
  border-radius: 14rpx;
  padding: 0 22rpx;
  font-size: 27rpx;
  color: #3D362A;
}

.error {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #A4653A;
}

/* 成功面板 */
.success-panel {
  width: 100%;
  background: #FCF9F1;
  border-radius: 28rpx;
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 60rpx 40rpx 70rpx;
}

.success-icon {
  width: 96rpx;
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 50%;
  background: #EDE4D2;
  color: #8A7152;
  font-size: 52rpx;
  font-weight: 600;
}

.success-text {
  margin-top: 32rpx;
  font-size: 30rpx;
  color: #3D362A;
  font-weight: 500;
  text-align: center;
  line-height: 1.6;
}

/* 每日房型 / 间数 */
.room-row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-top: 18rpx;
  padding-top: 18rpx;
  border-top: 1rpx solid #F0EADB;
}

.room-item {
  display: flex;
  align-items: center;
}

.room-label {
  font-size: 26rpx;
  color: #817A6A;
  margin-right: 16rpx;
}

.room-pick {
  font-size: 26rpx;
  color: #3D362A;
  background: #F3EDDF;
  border-radius: 12rpx;
  padding: 12rpx 24rpx;
}

.room-qty .stepper-btn {
  width: 52rpx;
  height: 52rpx;
  line-height: 52rpx;
  text-align: center;
  font-size: 32rpx;
  color: #8A7152;
  background: #EDE4D2;
  border-radius: 12rpx;
}

.room-qty .stepper-num {
  min-width: 56rpx;
  text-align: center;
  font-size: 28rpx;
  font-weight: 500;
  color: #3D362A;
}

/* 员工内部核算价卡片 */
.quote-card {
  background: #FBF4E6;
  border: 2rpx solid #E7D9BC;
}

.quote-card .card-title::before {
  background: #A4653A;
}

.quote-sum {
  display: flex;
  align-items: center;
  justify-content: space-between;
  padding: 16rpx 0;
  border-top: 1rpx solid #F0E6CE;
  font-size: 27rpx;
  color: #6E6555;
}

.quote-sum:first-of-type {
  border-top: none;
}

.quote-sum-label {
  color: #817A6A;
}

.quote-sum-val {
  color: #3D362A;
}

.quote-total {
  border-top: 2rpx solid #E7D9BC;
  margin-top: 6rpx;
  padding-top: 20rpx;
}

.quote-sum-val.total {
  font-size: 36rpx;
  font-weight: 600;
  color: #A4653A;
}

.quote-bd {
  margin-top: 16rpx;
  border-top: 1rpx dashed #E7D9BC;
  padding-top: 14rpx;
}

.quote-bd-row {
  display: flex;
  align-items: center;
  padding: 8rpx 0;
  font-size: 24rpx;
  color: #6E6555;
}

.quote-bd-day {
  width: 100rpx;
  flex: 0 0 100rpx;
  color: #9E9886;
}

.quote-bd-name {
  flex: 1;
  min-width: 0;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.quote-bd-unit {
  color: #9E9886;
  margin: 0 14rpx;
}

.quote-bd-sub {
  width: 130rpx;
  text-align: right;
  flex: 0 0 130rpx;
  color: #3D362A;
}

.quote-warn {
  margin-top: 16rpx;
  font-size: 24rpx;
  color: #A4653A;
}
/* 按人门票明细（定制师内部核算） */
.quote-bd-row { flex-wrap: wrap; }
.quote-bd-persons { width: 100%; margin-top: 6rpx; padding-left: 16rpx; box-sizing: border-box; }
.quote-bd-person { display: flex; font-size: 22rpx; color: #8A8070; line-height: 1.7; }
.qp-who { width: 110rpx; }
.qp-kind { width: 200rpx; }
.qp-reason { flex: 1; color: #B07A2A; }
.qp-pick { color: #3C6E47; text-decoration: underline; }


/* scenic packages：落在景区卡片文档流内，不使用浮层/绝对定位，避免挡酒店区与操作按钮 */
.pkg-box {
  position: relative;
  z-index: 2;
  margin: 4rpx 0 4rpx 64rpx;
  padding: 12rpx 14rpx;
  background: #FFFFFF;
  border: 1rpx solid #E8E0D0;
  border-radius: 12rpx;
  box-sizing: border-box;
  pointer-events: auto;
}
.pkg-intro { font-size: 22rpx; color: #8A8070; line-height: 1.5; margin-bottom: 8rpx; }
.pkg-title { font-size: 22rpx; color: #3C6E47; font-weight: 600; margin-bottom: 6rpx; }
.pkg-item {
  display: flex;
  align-items: center;
  padding: 12rpx 4rpx;
  font-size: 24rpx;
  color: #5A5346;
  position: relative;
  z-index: 2;
  pointer-events: auto;
}
.pkg-item-hover { background: #F7F4EC; border-radius: 8rpx; }
.pkg-item.on { color: #2F5D3A; }
.pkg-check {
  width: 48rpx;
  height: 48rpx;
  line-height: 48rpx;
  text-align: center;
  flex: 0 0 48rpx;
  font-size: 30rpx;
  color: #8A7152;
  pointer-events: auto;
}
.pkg-check.on { color: #2F5D3A; }
.pkg-name { flex: 1; min-width: 0; pointer-events: none; }
.pkg-price { flex: 0 0 auto; color: #B07A2A; margin-left: 12rpx; pointer-events: none; }

/* 员工计费用车：按天 chips，客人侧不渲染 */
.car-use {
  margin-top: 16rpx;
  padding-top: 8rpx;
  border-top: 1rpx solid #F0E6CE;
}
.car-use-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
}
.car-use-label {
  font-size: 26rpx;
  color: #6E6555;
}
.car-use-step {
  display: flex;
  align-items: center;
}
.car-use-reset {
  margin-left: 16rpx;
  font-size: 22rpx;
  color: #8A7152;
  text-decoration: underline;
}
.car-use-hint {
  margin-top: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
  color: #9E9886;
}
.car-use-days {
  display: flex;
  flex-wrap: wrap;
  margin-top: 12rpx;
}
.car-use-chip {
  min-width: 148rpx;
  margin: 0 12rpx 12rpx 0;
  padding: 12rpx 16rpx;
  border-radius: 16rpx;
  background: #F2ECDF;
  color: #817A6A;
  box-sizing: border-box;
}
.car-use-chip.on {
  background: #8A7152;
  color: #FCF9F1;
}
.car-use-d1 {
  font-size: 24rpx;
  font-weight: 500;
}
.car-use-d2 {
  margin-top: 4rpx;
  font-size: 20rpx;
}

