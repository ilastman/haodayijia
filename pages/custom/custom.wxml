<page-meta page-style="{{dragIndex >= 0 ? 'overflow: hidden;' : ''}}" />
<view class="page">

  <!-- 头部 -->
  <view class="head">
    <view class="head-title">{{c.title}}</view>
    <view class="head-sub">{{c.subtitle}}</view>
  </view>

  <!-- ① 基础信息 -->
  <view class="card">
    <view class="card-title">{{c.base}}</view>

    <!-- 天数 -->
    <view class="row">
      <view class="row-label">{{c.daysLabel}}</view>
      <view class="chips">
        <view class="chip {{days === 3 && !customActive ? 'on' : ''}}" data-n="3" bindtap="onDays">{{c.days[0]}}</view>
        <view class="chip {{days === 5 && !customActive ? 'on' : ''}}" data-n="5" bindtap="onDays">{{c.days[1]}}</view>
        <view class="chip {{days === 7 && !customActive ? 'on' : ''}}" data-n="7" bindtap="onDays">{{c.days[2]}}</view>
        <view class="chip {{customActive ? 'on' : ''}}" data-n="custom" bindtap="onDays">{{c.days[3]}}</view>
      </view>
    </view>
    <view class="row" wx:if="{{customActive}}">
      <view class="row-label"></view>
      <view class="custom-days">
        <input class="days-input" type="number" maxlength="2" placeholder="{{c.customDaysPlaceholder}}" placeholder-class="ph" value="{{customDays}}" bindinput="onCustomInput" />
        <text class="days-unit">{{c.daysUnit}}</text>
      </view>
    </view>

    <!-- 日期 -->
    <view class="row">
      <view class="row-label">{{c.dateLabel}}</view>
      <picker mode="date" value="{{date}}" start="{{minDate}}" bindchange="onDateChange">
        <view class="field-input {{date ? '' : 'ph'}}">{{date || c.datePlaceholder}}</view>
      </picker>
    </view>

    <!-- 人数 -->
    <view class="row">
      <view class="row-label">{{c.peopleLabel}}</view>
      <view class="steppers">
        <view class="stepper">
          <text class="stepper-label">{{c.adult}}</text>
          <view class="stepper-btn" bindtap="onAdult" data-d="-">−</view>
          <text class="stepper-num">{{adults}}</text>
          <view class="stepper-btn" bindtap="onAdult" data-d="+">+</view>
        </view>
        <view class="stepper stepper-sub">
          <text class="stepper-label">{{c.child}}</text>
          <view class="stepper-btn" bindtap="onChild" data-d="-">−</view>
          <text class="stepper-num">{{children}}</text>
          <view class="stepper-btn" bindtap="onChild" data-d="+">+</view>
        </view>
      </view>
    </view>
    <view class="tip-line">{{c.editHint}}</view>
  </view>

  <!-- 封面：私人定制封面层，必填 -->
  <view class="card">
    <view class="card-title">{{c.coverTitle}}<text class="req">*</text></view>
    <view class="tip-line">{{c.coverRequired}}</view>
    <view class="cover-row" wx:if="{{cover}}">
      <image class="cover-preview" src="{{cover}}" mode="aspectFill" />
      <view class="op-btn del" bindtap="clearCover">{{c.remove}}</view>
    </view>
    <view class="sel-empty" wx:else>{{c.coverEmpty}}</view>
    <view class="upload-slots">
      <view class="upload-slot cover-upload" bindtap="uploadCover">
        <view class="upload-plus">+</view>
        <text class="upload-hint">{{c.coverSlotHint}}</text>
        <text class="upload-sub">{{c.coverSlotUpload}}</text>
      </view>
      <view class="upload-slot cover-pick" bindtap="openCoverLib">
        <view class="upload-plus">+</view>
        <text class="upload-hint">{{c.coverSlotHint}}</text>
        <text class="upload-sub">{{c.coverSlotPick}}</text>
      </view>
    </view>
  </view>

  <!-- ② 每日行程标签 -->
  <scroll-view scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="day-scroll">
    <view class="day-chip {{activeDay === index ? 'on' : ''}}" wx:for="{{dayTabs}}" wx:key="index"
      bindtap="onDay" data-index="{{index}}">{{item}}</view>
  </scroll-view>

  <!-- ③ 当日行程编辑 -->
  <view class="card">
    <view class="card-title">{{c.scenicTitle}}</view>
    <view class="add-btn" bindtap="openScenic">+ {{c.addScenic}}</view>

    <view class="sel-list {{dragIndex >= 0 ? 'live' : ''}}" wx:if="{{curScenics.length > 0}}">
      <view class="sel-item {{dragIndex === index ? 'dragging' : ''}} {{dropIndex === index && dragIndex !== index ? 'drop-on' : ''}}"
        wx:for="{{curScenics}}" wx:key="id"
        style="transform: translateY({{rowShift[index] || 0}}px);">
        <view class="drag-handle" data-index="{{index}}"
          catchtouchstart="dragStart" catchtouchmove="dragMove" catchtouchend="dragEnd" catchtouchcancel="dragEnd">
          <text class="sel-order">{{index + 1}}</text>
        </view>
        <view class="sel-body">
          <view class="sel-name">{{item.name}}</view>
          <view class="sel-sub">{{item.dest}}</view>
        </view>
        <view class="sel-ops">
          <view class="op-btn" bindtap="moveSel" data-index="{{index}}" data-dir="-1">{{c.up}}</view>
          <view class="op-btn" bindtap="moveSel" data-index="{{index}}" data-dir="1">{{c.down}}</view>
          <view class="op-btn del" bindtap="removeScenic" data-index="{{index}}">{{c.remove}}</view>
        </view>
      </view>
    </view>
    <view class="sel-empty" wx:else>{{c.scenicEmpty}}</view>
    <view class="tip-line">{{c.tips}}</view>
  </view>

  <view class="card">
    <view class="card-title">{{c.hotelTitle}}</view>
    <view class="add-btn" bindtap="openHotel">+ {{c.addHotel}}</view>
    <view class="hotel-sel" wx:if="{{curHotel}}">
      <image class="hotel-cover" src="{{curHotel.image}}" mode="aspectFill" lazy-load="{{true}}" />
      <view class="sel-body">
        <view class="sel-name">{{curHotel.name}}</view>
        <view class="sel-sub">{{curHotel.stars}} · {{curHotel.area}}</view>
      </view>
      <view class="op-btn del" bindtap="clearHotel">{{c.remove}}</view>
    </view>
    <view class="sel-empty" wx:else>{{c.hotelEmpty}}</view>

    <!-- 房型与间数（每天） -->
    <view class="room-row" wx:if="{{curHotel}}">
      <view class="room-item">
        <text class="room-label">房型</text>
        <picker mode="selector" range="{{curRoomTypes}}" bindchange="onRoomType">
          <view class="room-pick">{{plans[activeDay].roomType || curRoomTypes[0]}} ▾</view>
        </picker>
      </view>
      <view class="room-item room-qty">
        <text class="room-label">间数</text>
        <view class="stepper">
          <view class="stepper-btn" bindtap="onRoomQty" data-d="-">−</view>
          <text class="stepper-num">{{plans[activeDay].roomQty || 1}}</text>
          <view class="stepper-btn" bindtap="onRoomQty" data-d="+">+</view>
        </view>
      </view>
    </view>

    <!-- 同级备选：与「选择酒店」相同的底部面板，候选已锁在主酒店的二级大区 -->
    <view class="alt-block" wx:if="{{curHotel && altCanPick}}">
      <view class="alt-title">{{c.hotelAltTitle}}</view>
      <view class="add-btn" bindtap="openAlt">+ {{c.addHotel}}</view>
      <view class="hotel-sel alt-sel" wx:for="{{altPicked}}" wx:key="id">
        <image class="hotel-cover" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
        <view class="sel-body">
          <view class="sel-name">{{item.name}}</view>
          <view class="sel-sub">{{item.stars}} · {{item.area}}</view>
        </view>
        <view class="op-btn del" catchtap="toggleAlt" data-id="{{item.id}}">{{c.remove}}</view>
      </view>
    </view>
  </view>

  <view class="card">
    <view class="card-title">{{c.promoTitle}}</view>
    <view class="tip-line">{{c.promoHint}}</view>
    <view class="promo-row" wx:if="{{curPromo.length}}">
      <view class="promo-cell" wx:for="{{curPromo}}" wx:key="*this">
        <image class="promo-img" src="{{item}}" mode="aspectFill" />
        <view class="op-btn del" catchtap="removePromo" data-index="{{index}}">{{c.remove}}</view>
      </view>
    </view>
    <view class="upload-slots">
      <view class="upload-slot promo-upload" bindtap="uploadPromo">
        <view class="upload-plus">+</view>
        <text class="upload-hint">{{c.promoSlotHint}}</text>
        <text class="upload-sub">{{c.promoSlotUpload}}</text>
      </view>
      <view class="upload-slot promo-pick" bindtap="openPromoLib">
        <view class="upload-plus">+</view>
        <text class="upload-hint">{{c.promoSlotHint}}</text>
        <text class="upload-sub">{{c.promoSlotPick}}</text>
      </view>
    </view>
  </view>

  <view class="card car-card">
    <view class="card-title">{{c.carTitle}}</view>
    <view class="add-btn" bindtap="openCar">+ {{c.addCar}}</view>
    <view class="hotel-sel" wx:if="{{curCar}}">
      <image class="hotel-cover" src="{{curCar.image}}" mode="aspectFill" lazy-load="{{true}}" />
      <view class="sel-body">
        <view class="sel-name">{{curCar.name}}</view>
        <view class="sel-sub">{{curCar.type}} · {{curCar.seats}}座</view>
      </view>
      <view class="op-btn del" bindtap="clearCar">{{c.remove}}</view>
    </view>
    <view class="sel-empty" wx:else>{{c.carEmpty}}</view>
  </view>

  <view class="card">
    <view class="card-title">{{c.noteTitle}}</view>
    <textarea class="note" placeholder="{{c.notePlaceholder}}" placeholder-class="ph" value="{{curNote}}"
      bindinput="onNote" maxlength="200" auto-height />
  </view>

  <!-- 对客报价 + 内部核算（仅员工；客人看不到内部核算）。放在当天内容之后。 -->
  <view class="card quote-card" wx:if="{{isStaff}}">
    <view class="card-title">对客报价</view>
    <view class="row">
      <view class="row-label">客人称呼</view>
      <input class="guest-input" placeholder="如：张先生" placeholder-class="ph" value="{{guestName}}" bindinput="onGuestName" maxlength="20" />
    </view>
    <view class="row">
      <view class="row-label">每人报价</view>
      <input class="guest-input" type="digit" placeholder="填写给客人的每人价格" placeholder-class="ph" value="{{guestQuote}}" bindinput="onGuestQuote" maxlength="8" />
      <text class="days-unit">元/人</text>
    </view>
    <view class="tip-line">客人页面标题旁显示每人报价，首屏下面标出总价（每人报价 × 成人和儿童）。内部核算不会出现在客人看到的页面上。</view>
    <view class="quote-sum quote-total" wx:if="{{guestTotalText}}">
      <text class="quote-sum-label">客人看到的总价</text>
      <text class="quote-sum-val total">{{guestTotalText}}</text>
    </view>
    <view class="tip-line" wx:if="{{guestTotalNote}}">{{guestTotalNote}}</view>
    <block wx:if="{{internalQuote}}">
    <view class="card-title quote-inner-title">内部核算价</view>
    <view class="quote-sum">
      <text class="quote-sum-label">酒店（逐日房型 × 间数）</text>
      <text class="quote-sum-val">¥{{internalQuote.hotel}}</text>
    </view>
    <view class="quote-sum">
      <text class="quote-sum-label">门票（{{internalQuote.people}}人）</text>
      <text class="quote-sum-val">¥{{internalQuote.ticket}}</text>
    </view>
    <view class="quote-sum quote-total">
      <text class="quote-sum-label">内部核算合计</text>
      <text class="quote-sum-val total">¥{{internalQuote.total}}</text>
    </view>
    <view class="quote-bd" wx:if="{{internalQuote.breakdown.length}}">
      <view class="quote-bd-row" wx:for="{{internalQuote.breakdown}}" wx:key="index">
        <text class="quote-bd-day">{{item.day}}</text>
        <text class="quote-bd-name">{{item.name}}</text>
        <text class="quote-bd-unit">¥{{item.unit}} × {{item.qty}}</text>
        <text class="quote-bd-sub">¥{{item.subtotal}}</text>
      </view>
    </view>
    <view class="quote-warn" wx:if="{{internalQuote.missing.length}}">部分选择未匹配到后台价（景区未设票价 / 酒店该入住日无价格档期），请核对</view>
    </block>
  </view>

  <view class="safe-bottom"></view>

  <!-- ④ 底部固定提交栏 -->
  <view class="bottom-bar">
    <view class="summary">
      <text class="sum-item">{{c.summaryScenic}} {{totalScenic}}</text>
      <text class="sum-item">{{c.summaryHotel}} {{totalHotel}}</text>
    </view>
    <view class="submit-btn {{generating ? 'is-busy' : ''}}" bindtap="goGenerate">{{generating ? '正在生成…' : c.generateBtn}}</view>
  </view>

  <!-- 私人定制封面 -->
  <view class="sheet-mask" wx:if="{{sheet && sheet.type === 'cover'}}" bindtap="closeSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{c.coverSheet}}</text>
        <view class="sheet-confirm" bindtap="closeSheet">{{c.sheetConfirm}}</view>
      </view>
      <scroll-view scroll-y="{{true}}" class="sheet-list">
        <view class="opt" wx:for="{{coverLib}}" wx:key="id" catchtap="pickCoverLib" data-url="{{item.url}}">
          <image class="opt-thumb" src="{{item.url}}" mode="aspectFill" />
          <view class="opt-body"><view class="opt-name">{{item.name}}</view></view>
        </view>
        <view class="sel-empty" wx:if="{{coverLib.length === 0}}">封面图库还是空的，可先上传，或在后台「图库管理 · 私人定制封面」添加</view>
      </scroll-view>
    </view>
  </view>

  <!-- 当日宣传图 -->
  <view class="sheet-mask" wx:if="{{sheet && sheet.type === 'promo'}}" bindtap="closeSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{c.promoSheet}}</text>
        <view class="sheet-confirm" bindtap="closeSheet">{{c.sheetConfirm}}</view>
      </view>
      <scroll-view scroll-y="{{true}}" class="sheet-list">
        <view class="opt" wx:for="{{promoLib}}" wx:key="id" catchtap="pickPromoLib" data-url="{{item.url}}">
          <image class="opt-thumb" src="{{item.url}}" mode="aspectFill" />
          <view class="opt-body"><view class="opt-name">{{item.name}}</view></view>
        </view>
        <view class="sel-empty" wx:if="{{promoLib.length === 0}}">宣传图库还是空的，可直接上传，或在后台按酒店 / 景区分类添加</view>
      </scroll-view>
    </view>
  </view>

  <!-- 景区选择面板 -->
  <view class="sheet-mask" wx:if="{{sheet && sheet.type === 'scenic'}}" bindtap="closeSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{c.sheetScenicTitle}}</text>
        <view class="sheet-confirm" bindtap="closeSheet">{{c.sheetConfirm}}</view>
      </view>
      <scroll-view scroll-x="{{true}}" class="sheet-cats" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="sheet-chip {{sheetRegion === item ? 'on' : ''}}" wx:for="{{sheetRegions}}" wx:key="*this" bindtap="onSheetRegion" data-region="{{item}}">{{item}}</view>
      </scroll-view>
      <scroll-view scroll-x="{{true}}" class="sheet-cats" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="sheet-chip {{sheetSub === item.key ? 'on' : ''}}" wx:for="{{sheetSubs}}" wx:key="key" bindtap="onSheetSub" data-sub="{{item.key}}">{{item.label}}</view>
      </scroll-view>
      <scroll-view scroll-x="{{true}}" class="sheet-cats" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="sheet-chip {{sheetPlace === item ? 'on' : ''}}" wx:for="{{sheetPlaces}}" wx:key="*this" bindtap="onSheetPlace" data-place="{{item}}">{{item}}</view>
      </scroll-view>
      <scroll-view scroll-y="{{true}}" class="sheet-list">
        <view class="sel-empty" wx:if="{{sheetScenics.length === 0}}">该分类下暂无景区</view>
        <view class="opt {{item.sel ? 'on' : ''}}" wx:for="{{sheetScenics}}" wx:key="id" catchtap="toggleScenic" data-id="{{item.id}}">
          <view class="opt-body">
            <view class="opt-name">{{item.name}}</view>
            <view class="opt-sub ellipsis">{{item.dest}} · {{item.intro}}</view>
          </view>
          <view class="opt-check">{{item.sel ? '✓' : ''}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 酒店选择面板 -->
  <view class="sheet-mask" wx:if="{{sheet && sheet.type === 'hotel'}}" bindtap="closeSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{c.sheetHotelTitle}}</text>
        <view class="sheet-confirm" bindtap="closeSheet">{{c.sheetConfirm}}</view>
      </view>
      <scroll-view scroll-x="{{true}}" class="sheet-cats" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="sheet-chip {{sheetRegion === item ? 'on' : ''}}" wx:for="{{sheetRegions}}" wx:key="*this" bindtap="onSheetRegion" data-region="{{item}}">{{item}}</view>
      </scroll-view>
      <scroll-view scroll-x="{{true}}" class="sheet-cats" enhanced="{{true}}" show-scrollbar="{{false}}">
        <view class="sheet-chip {{sheetPlace === item ? 'on' : ''}}" wx:for="{{sheetPlaces}}" wx:key="*this" bindtap="onSheetPlace" data-place="{{item}}">{{item}}</view>
      </scroll-view>
      <scroll-view scroll-y="{{true}}" class="sheet-list">
        <view class="sel-empty" wx:if="{{sheetHotels.length === 0}}">该分类下暂无酒店</view>
        <view class="opt {{item.sel ? 'on' : ''}}" wx:for="{{sheetHotels}}" wx:key="id" catchtap="toggleHotel" data-id="{{item.id}}">
          <view class="opt-body">
            <view class="opt-name">{{item.name}}</view>
            <view class="opt-sub ellipsis">{{item.stars}} · {{item.area}}</view>
          </view>
          <view class="opt-check">{{item.sel ? '✓' : ''}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 用车车型 -->
  <view class="sheet-mask" wx:if="{{sheet && sheet.type === 'car'}}" bindtap="closeSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{c.sheetCarTitle}}</text>
        <view class="sheet-confirm" bindtap="closeSheet">{{c.sheetConfirm}}</view>
      </view>
      <scroll-view scroll-y="{{true}}" class="sheet-list">
        <view class="sel-empty" wx:if="{{sheetCars.length === 0}}">暂无车型</view>
        <view class="opt {{item.sel ? 'on' : ''}}" wx:for="{{sheetCars}}" wx:key="id" catchtap="toggleCar" data-id="{{item.id}}">
          <view class="opt-body">
            <view class="opt-name">{{item.name}}</view>
            <view class="opt-sub ellipsis">{{item.type}} · {{item.seats}}座</view>
          </view>
          <view class="opt-check">{{item.sel ? '✓' : ''}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 同等级备选酒店：面板样式与主酒店一致，列表不含其他二级大区 -->
  <view class="sheet-mask" wx:if="{{sheet && sheet.type === 'alt'}}" bindtap="closeSheet">
    <view class="sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{c.sheetAltTitle}}</text>
        <view class="sheet-confirm" bindtap="closeSheet">{{c.sheetConfirm}}</view>
      </view>
      <scroll-view scroll-y="{{true}}" class="sheet-list">
        <view class="sel-empty" wx:if="{{sheetHotels.length === 0}}">{{c.altEmpty}}</view>
        <view class="opt {{item.sel ? 'on' : ''}}" wx:for="{{sheetHotels}}" wx:key="id" catchtap="toggleAlt" data-id="{{item.id}}">
          <view class="opt-body">
            <view class="opt-name">{{item.name}}</view>
            <view class="opt-sub ellipsis">{{item.stars}} · {{item.area}}</view>
          </view>
          <view class="opt-check">{{item.sel ? '✓' : ''}}</view>
        </view>
      </scroll-view>
    </view>
  </view>

  <!-- 提交表单弹窗 -->
  <view class="sheet-mask" wx:if="{{submitShow}}" bindtap="closeSubmit">
    <view class="sheet form-sheet" catchtap="noop">
      <view class="sheet-head">
        <text class="sheet-title">{{c.formTitle}}</text>
        <view class="sheet-confirm" bindtap="closeSubmit">{{c.sheetCancel}}</view>
      </view>
      <view class="field">
        <view class="label">{{c.name}}<text class="req">*</text></view>
        <input class="input" placeholder="{{c.namePlaceholder}}" placeholder-class="ph" value="{{form.name}}"
          data-k="name" bindinput="onFormInput" maxlength="20" />
      </view>
      <view class="field">
        <view class="label">{{c.phone}}<text class="req">*</text></view>
        <input class="input" type="number" placeholder="{{c.phonePlaceholder}}" placeholder-class="ph" value="{{form.phone}}"
          data-k="phone" bindinput="onFormInput" maxlength="11" />
      </view>
      <view class="field">
        <view class="label">{{c.wechat}}</view>
        <input class="input" placeholder="{{c.wechatPlaceholder}}" placeholder-class="ph" value="{{form.wechat}}"
          data-k="wechat" bindinput="onFormInput" maxlength="30" />
      </view>
      <view class="error" wx:if="{{formError}}">{{formError}}</view>
      <view class="submit-btn full" bindtap="doSubmit">{{c.submitBtn}}</view>
    </view>
  </view>

  <!-- 提交成功 -->
  <view class="sheet-mask" wx:if="{{successShow}}" bindtap="closeSuccess">
    <view class="success-panel">
      <view class="success-icon">✓</view>
      <view class="success-text">{{c.success}}</view>
    </view>
  </view>
</view>