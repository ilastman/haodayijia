<view class="page">

  <view class="card">
    <view class="row" bindtap="onAvatarTap">
      <text class="label">头像</text>
      <view class="row-right">
        <image class="avatar" src="{{avatar}}" mode="aspectFill" wx:if="{{avatar}}" />
        <view class="avatar avatar-empty" wx:else>{{(nickname && nickname[0]) || '旅'}}</view>
        <text class="chev">›</text>
      </view>
    </view>

    <view class="row row-input">
      <text class="label">昵称</text>
      <input
        class="value-input"
        type="text"
        maxlength="20"
        placeholder="请输入昵称"
        placeholder-class="ph"
        value="{{nickname}}"
        bindinput="onNickInput"
      />
    </view>

    <picker mode="selector" range="{{genderOptions}}" value="{{genderIndex}}" bindchange="onGenderChange">
      <view class="row">
        <text class="label">性别</text>
        <view class="row-right">
          <text class="{{gender ? 'value' : 'ph'}}">{{gender || '请选择性别'}}</text>
          <text class="chev">›</text>
        </view>
      </view>
    </picker>

    <picker mode="date" value="{{birthday || '1995-01-01'}}" start="1940-01-01" end="{{today}}" bindchange="onBirthdayChange">
      <view class="row row-last">
        <text class="label">生日</text>
        <view class="row-right">
          <text class="{{birthday ? 'value' : 'ph'}}">{{birthday || '请选择生日'}}</text>
          <text class="chev">›</text>
        </view>
      </view>
    </picker>
  </view>

  <view class="card">
    <view class="row row-input">
      <text class="label">手机号</text>
      <input
        class="value-input"
        type="number"
        maxlength="11"
        placeholder="请输入手机号"
        placeholder-class="ph"
        value="{{phone}}"
        bindinput="onPhoneInput"
      />
    </view>
    <view class="row row-input row-last">
      <text class="label">邮箱</text>
      <input
        class="value-input"
        type="text"
        maxlength="64"
        placeholder="请输入邮箱"
        placeholder-class="ph"
        value="{{email}}"
        bindinput="onEmailInput"
      />
    </view>
  </view>

  <view class="agree-row" catchtap="toggleAgree">
    <view class="agree-box">{{agreed ? '☑' : '☐'}}</view>
    <view class="agree-text">
      <text>我已阅读并同意</text>
      <text class="agree-link" catchtap="openLegal" data-kind="agreement">《用户服务协议》</text>
      <text>和</text>
      <text class="agree-link" catchtap="openLegal" data-kind="privacy">《隐私政策》</text>
      <text>。未同意不会保存资料。</text>
    </view>
  </view>
  <view class="save-wrap">
    <view class="save-btn" bindtap="onSave">保存</view>
  </view>

</view>
