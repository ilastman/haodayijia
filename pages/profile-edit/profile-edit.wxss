.page {
  min-height: 100%;
  padding: 24rpx 24rpx 80rpx;
  box-sizing: border-box;
  background: #F3F0E8;
}
.agree-row { display: flex; align-items: flex-start; margin: 8rpx 8rpx 20rpx; }
.agree-box { width: 40rpx; font-size: 32rpx; line-height: 1.5; color: #8A7152; flex: 0 0 40rpx; }
.agree-text { flex: 1; font-size: 24rpx; line-height: 1.6; color: #5C5346; }
.agree-link { color: #8A7152; text-decoration: underline; }

.card {
  background: #FCF9F1;
  border-radius: 20rpx;
  overflow: hidden;
  margin-bottom: 24rpx;
}

.row {
  display: flex;
  align-items: center;
  justify-content: space-between;
  min-height: 112rpx;
  padding: 20rpx 28rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid rgba(138, 113, 82, 0.12);
}

.row-last {
  border-bottom: none;
}

.row-input {
  padding-top: 12rpx;
  padding-bottom: 12rpx;
}

.label {
  flex-shrink: 0;
  width: 140rpx;
  font-size: 30rpx;
  color: #3D3226;
  letter-spacing: 1rpx;
}

.row-right {
  flex: 1;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  min-width: 0;
}

.avatar {
  width: 88rpx;
  height: 88rpx;
  border-radius: 50%;
  background: #EDE4D2;
  margin-right: 8rpx;
}

.avatar-empty {
  display: flex;
  align-items: center;
  justify-content: center;
  color: #8A7152;
  font-size: 36rpx;
}

.value {
  font-size: 30rpx;
  color: #3D3226;
  letter-spacing: 1rpx;
}

.value-input {
  flex: 1;
  text-align: right;
  font-size: 30rpx;
  color: #3D3226;
  height: 72rpx;
  letter-spacing: 1rpx;
}

.ph {
  color: #B5AA98;
  font-size: 28rpx;
}

.chev {
  margin-left: 8rpx;
  color: #C4B8A4;
  font-size: 36rpx;
  line-height: 1;
}

.save-wrap {
  margin-top: 48rpx;
  padding: 0 8rpx;
}

.save-btn {
  height: 96rpx;
  line-height: 96rpx;
  text-align: center;
  border-radius: 48rpx;
  background: #5C4A36;
  color: #FCF9F1;
  font-size: 32rpx;
  letter-spacing: 6rpx;
  box-shadow: 0 10rpx 28rpx rgba(92, 74, 54, 0.22);
}
