.ed-section { margin: 24rpx 28rpx 0; background: #FCF9F1; border-radius: 20rpx; padding: 10rpx 26rpx 6rpx; box-shadow: 0 4rpx 20rpx rgba(90, 82, 66, 0.05); }
.ed-h { font-size: 30rpx; font-weight: 600; color: #443A2C; padding: 22rpx 0 12rpx; }
.ed-row { display: flex; align-items: center; min-height: 92rpx; border-top: 1rpx solid #F0EAD9; }
.ed-l { width: 200rpx; font-size: 28rpx; color: #6E6656; flex: 0 0 200rpx; }
.ed-i { flex: 1; font-size: 28rpx; color: #3D362A; }
.ed-pick { flex: 1; font-size: 28rpx; color: #3D362A; }
.ed-actions { margin: 40rpx 28rpx 0; }
.ed-actions .disabled { opacity: .6; }
