.page {
  background: #F6F1E7;
  padding-bottom: 60rpx;
}

/* 1. 页头 */
.header {
  padding: 96rpx 48rpx 0;
}

.header-title {
  font-size: 44rpx;
  font-weight: 300;
  letter-spacing: 6rpx;
  color: #3D362A;
  line-height: 1.4;
}

.header-slogan {
  margin-top: 18rpx;
  font-size: 24rpx;
  font-weight: 300;
  letter-spacing: 3rpx;
  color: #948D7D;
}

/* 2. 分类标签 */
.cat-zone {
  display: flex;
  align-items: center;
  margin-top: 60rpx;
  padding: 0 24rpx;
}

.cat-scroll {
  flex: 1;
  min-width: 0;
  white-space: nowrap;
}

.cat-row {
  display: inline-flex;
  align-items: center;
}

.cat {
  display: inline-block;
  font-size: 26rpx;
  color: #948D7D;
  letter-spacing: 2rpx;
  padding: 14rpx 4rpx;
  margin-right: 46rpx;
  border-bottom: 3rpx solid transparent;
  transition: color .2s;
}

.cat.on {
  color: #5F4B33;
  border-bottom-color: #8A7152;
}

.cat:last-child {
  margin-right: 12rpx;
}

/* 更多筛选 */
.more-toggle {
  flex-shrink: 0;
  display: flex;
  align-items: center;
  font-size: 23rpx;
  color: #ADA690;
  letter-spacing: 1rpx;
  padding: 10rpx 0 10rpx 20rpx;
}

.more-toggle.on {
  color: #8A7152;
}

.more-arrow {
  font-size: 18rpx;
  margin-left: 8rpx;
}

.more-panel {
  margin: 22rpx 48rpx 0;
  border-top: 1rpx solid #E1D7C2;
  border-bottom: 1rpx solid #E1D7C2;
  padding: 26rpx 0 12rpx;
}

.more-group {
  margin-bottom: 22rpx;
}

.mg-title {
  font-size: 21rpx;
  color: #B0A997;
  letter-spacing: 3rpx;
  margin-bottom: 14rpx;
}

.mg-chips {
  display: flex;
  flex-wrap: wrap;
}

.mg-chip {
  font-size: 23rpx;
  color: #817A6A;
  border: 1rpx solid #DED6C3;
  border-radius: 10rpx;
  padding: 10rpx 26rpx;
  margin: 0 18rpx 14rpx 0;
}

.mg-chip.on {
  border-color: #8A7152;
  color: #8A7152;
}

/* 3. 大封面纵向画册卡片 */
.list {
  padding: 46rpx 40rpx 0;
}

.route-card {
  overflow: hidden;
  background: #FCF9F1;
  border: 1rpx solid #F0EADC;
  border-radius: 24rpx;
  padding: 0;
  margin-bottom: 40rpx;
}

.rc-cover {
  width: 100%;
  height: 470rpx;
  display: block;
  background: #EDE5D6;
}

.rc-body {
  display: flex;
  flex-direction: column;
  padding: 26rpx 26rpx 30rpx;
}

.rc-days {
  font-size: 21rpx;
  color: #ADA690;
  letter-spacing: 3rpx;
}

.rc-name {
  margin-top: 14rpx;
  font-size: 30rpx;
  font-weight: 400;
  color: #3D362A;
  line-height: 1.45;
}

.rc-brief {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #817A6A;
  line-height: 1.6;
}

.ellipsis {
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 空状态 */
.empty {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 160rpx 0 40rpx;
  color: #ADA690;
}

.empty-icon {
  font-size: 44rpx;
  margin-bottom: 20rpx;
}

.empty text {
  font-size: 24rpx;
  letter-spacing: 2rpx;
}

/* 4. 底部引导 */
.foot-guide {
  margin-top: 70rpx;
  padding: 0 48rpx;
}

.hairline {
  border-top: 1rpx solid #E1D7C2;
  margin-bottom: 56rpx;
}

.fg-title {
  font-size: 27rpx;
  color: #443A2C;
  letter-spacing: 2rpx;
  text-align: center;
}

.fg-desc {
  margin-top: 14rpx;
  font-size: 23rpx;
  color: #948D7D;
  letter-spacing: 1rpx;
  text-align: center;
}

.outline-btn {
  width: 56%;
  margin: 40rpx auto 0;
  height: 84rpx;
  line-height: 82rpx;
  text-align: center;
  font-size: 26rpx;
  letter-spacing: 4rpx;
  color: #5F4B33;
  border: 1rpx solid #8A7152;
  border-radius: 42rpx;
  font-weight: 400;
  box-sizing: border-box;
}

.foot-guide.journal {
  margin-top: 40rpx;
  padding-bottom: 40rpx;
}

.journal-link {
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 24rpx;
  color: #948D7D;
  letter-spacing: 2rpx;
}

.journal-arrow {
  font-size: 30rpx;
  margin-left: 10rpx;
  color: #ADA690;
}