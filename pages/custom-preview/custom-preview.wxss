.cp-page {
  padding-bottom: 40rpx;
  min-height: 100vh;
  background: #FCF9F1;
}

/* 首屏 16:9 */
.cp-hero {
  position: relative;
  width: 100%;
  height: 422rpx;
  background: #2A2318;
  display: flex;
  flex-wrap: wrap;
  overflow: hidden;
}

.cp-hero-tile {
  flex: 1 1 50%;
  max-width: 50%;
  height: 50%;
  overflow: hidden;
}

.cp-hero-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cp-hero-shade {
  position: absolute;
  inset: 0;
  background: linear-gradient(180deg, rgba(42, 35, 24, 0.12) 0%, rgba(42, 35, 24, 0.35) 70%, rgba(42, 35, 24, 0.62) 100%);
}

.cp-hero-cap {
  position: absolute;
  left: 0;
  right: 0;
  top: 0;
  bottom: 0;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  padding: 0 40rpx;
}

.cp-hero-title {
  font-size: 44rpx;
  font-weight: 300;
  letter-spacing: 6rpx;
  color: #FBF7EE;
  text-align: center;
  text-shadow: 0 2rpx 12rpx rgba(42, 35, 24, 0.45);
}

.cp-hero-slogan {
  margin-top: 20rpx;
  font-size: 24rpx;
  font-weight: 300;
  letter-spacing: 3rpx;
  color: rgba(251, 247, 238, 0.82);
  text-shadow: 0 2rpx 10rpx rgba(42, 35, 24, 0.5);
  text-align: center;
}

/* 按天行程 */
.cp-plan {
  padding: 8rpx 24rpx 0;
}

.cp-day {
  background: #FCF9F1;
  border: 1rpx solid #EFE9DC;
  border-radius: 24rpx;
  padding: 30rpx 28rpx;
  margin-top: 24rpx;
}

.cp-day-scene {
  display: flex;
  align-items: baseline;
  padding-bottom: 22rpx;
  margin-bottom: 6rpx;
  border-bottom: 1rpx solid #F0EADB;
}

.cp-day-no {
  font-size: 34rpx;
  font-weight: 500;
  color: #8A7152;
}

.cp-day-unit {
  margin-left: 4rpx;
  font-size: 24rpx;
  color: #8A7152;
}

.cp-day-dot {
  margin: 0 16rpx;
  color: #C9C2B2;
}

.cp-day-name {
  flex: 1;
  min-width: 0;
  font-size: 28rpx;
  font-weight: 500;
  color: #3D362A;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

/* 景区行 */
.cp-spots {
  padding-top: 4rpx;
}

.cp-spot {
  display: flex;
  align-items: center;
  padding: 18rpx 0;
  border-bottom: 1rpx solid #F5F0E4;
}

.cp-thumb {
  width: 150rpx;
  height: 100rpx;
  border-radius: 12rpx;
  overflow: hidden;
  flex-shrink: 0;
  background: #EDE5D6;
}

.cp-thumb-img {
  width: 100%;
  height: 100%;
  display: block;
}

.cp-spot-body {
  flex: 1;
  min-width: 0;
  padding: 0 20rpx;
}

.cp-spot-name {
  font-size: 28rpx;
  font-weight: 500;
  color: #3D362A;
  overflow: hidden;
  white-space: nowrap;
  text-overflow: ellipsis;
}

.cp-spot-sub {
  margin-top: 8rpx;
  font-size: 22rpx;
  color: #9E9886;
}

.cp-arrow {
  font-size: 34rpx;
  color: #C9C2B2;
  flex-shrink: 0;
  line-height: 1;
}

.cp-spots-empty {
  padding: 26rpx 0 14rpx;
  display: flex;
  align-items: center;
}

.cp-dot-row {
  width: 16rpx;
  height: 16rpx;
  border-radius: 50%;
  background: #E0D8C6;
  margin-right: 14rpx;
}

.cp-empty-text {
  font-size: 24rpx;
  color: #ADA690;
}

/* 酒店行 */
.cp-hotel {
  display: flex;
  align-items: center;
  margin-top: 20rpx;
  background: #F5EFE2;
  border-radius: 16rpx;
  padding: 16rpx;
}

.cp-hotel .cp-thumb {
  width: 140rpx;
  height: 92rpx;
}

/* 同级备选酒店（纯文字） */
.cp-alt {
  margin-top: 12rpx;
  padding: 0 4rpx;
}

.cp-alt-title {
  font-size: 22rpx;
  color: #8A7152;
  margin-bottom: 8rpx;
}

.cp-alt-list {
  display: flex;
  flex-wrap: wrap;
}

.cp-alt-name {
  font-size: 24rpx;
  color: #6E6555;
  background: #F1E9DB;
  border-radius: 24rpx;
  padding: 6rpx 18rpx;
  margin: 0 12rpx 10rpx 0;
}

/* 备注 */
.cp-note {
  margin-top: 20rpx;
  background: #F7F2E8;
  border-radius: 16rpx;
  padding: 18rpx 20rpx;
}

.cp-note-label {
  font-size: 22rpx;
  letter-spacing: 2rpx;
  color: #8A7152;
  margin-bottom: 8rpx;
}

.cp-note-text {
  font-size: 25rpx;
  line-height: 1.7;
  color: #4A463A;
}

/* 底部按钮 */
.cp-bottom {
  display: flex;
  margin: 36rpx 24rpx 0;
}

.cp-btn {
  flex: 1;
  text-align: center;
  font-size: 27rpx;
  font-weight: 400;
  letter-spacing: 2rpx;
  padding: 24rpx 0;
  border-radius: 46rpx;
}

.cp-btn-outline {
  color: #8A7152;
  border: 2rpx solid #8A7152;
  background: #FCF9F1;
}

.cp-btn-outline + .cp-btn-outline {
  margin-left: 20rpx;
}

.cp-safe {
  height: 40rpx;
}

/* 基础信息标签区（与线路详情页一致） */
.info-bar {
  display: flex;
  margin: 8rpx 48rpx 4rpx;
  padding: 10rpx 0;
}

.info-item {
  flex: 1;
  min-width: 0;
  text-align: center;
  padding: 12rpx 0;
}

.info-item:not(:last-child) {
  border-right: 1rpx solid #E9E0CE;
}

.info-k {
  display: block;
  font-size: 20rpx;
  color: #B0A997;
  letter-spacing: 2rpx;
}

.info-v {
  display: block;
  margin-top: 12rpx;
  font-size: 24rpx;
  color: #5F4B33;
  letter-spacing: 1rpx;
}

/* 温馨提示 + 出行说明（与线路详情页面部区一致） */
.cp-commercial {
  padding: 34rpx 44rpx 0;
}

.cp-tips {
  margin-bottom: 16rpx;
}

.cp-tips .rd-note-line {
  margin-bottom: 10rpx;
}

.cp-tips .rd-note-line:last-child {
  margin-bottom: 0;
}

.cp-travel .cp-banner {
  font-size: 22rpx;
  color: #ADA690;
  line-height: 1.7;
  letter-spacing: 1rpx;
  margin-bottom: 34rpx;
}

.rd-note-line {
  font-size: 26rpx;
  color: #5B5344;
  line-height: 1.7;
}

.sec {
  margin-bottom: 40rpx;
}

.sec-title {
  font-size: 27rpx;
  color: #443A2C;
  letter-spacing: 3rpx;
  margin-bottom: 18rpx;
}

.sec-sub {
  font-size: 24rpx;
  color: #8A7152;
  letter-spacing: 1rpx;
  margin: 14rpx 0 8rpx;
}

.sec-item {
  font-size: 24rpx;
  color: #817A6A;
  line-height: 1.75;
  letter-spacing: 1rpx;
  margin-bottom: 8rpx;
}

.sec-chips {
  display: flex;
  flex-wrap: wrap;
}

.chip {
  background: #F1EBDD;
  color: #8A7152;
  font-size: 22rpx;
  border-radius: 8rpx;
  padding: 6rpx 16rpx;
  margin: 6rpx 12rpx 0 0;
}