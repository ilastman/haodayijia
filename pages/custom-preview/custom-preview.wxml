<view class="cp-page">

  <!-- 首屏：有封面时用封面，否则用景区拼图 -->
  <view class="cp-hero" wx:if="{{cover}}">
    <image class="cp-hero-img cp-hero-cover" src="{{cover}}" mode="aspectFill" />
    <view class="cp-hero-shade"></view>
    <view class="cp-hero-cap">
      <view class="cp-hero-title-row">
        <view class="cp-hero-title">{{heroTitle}}</view>
      </view>
      <view class="cp-hero-slogan">{{c.slogan}}</view>
    </view>
  </view>
  <view class="cp-hero" wx:else>
    <view class="cp-hero-tile" wx:for="{{heroTiles}}" wx:key="id">
      <image wx:if="{{item.img}}" class="cp-hero-img" src="{{item.img}}" mode="aspectFill" />
    </view>
    <view class="cp-hero-shade"></view>
    <view class="cp-hero-cap">
      <view class="cp-hero-title-row">
        <view class="cp-hero-title">{{heroTitle}}</view>
      </view>
      <view class="cp-hero-slogan">{{c.slogan}}</view>
    </view>
  </view>

  <!-- 四项信息在首图下面，不压在封面上 -->
  <view class="info-bar">
    <view class="info-item" wx:for="{{infoTags}}" wx:key="k">
      <text class="info-k">{{item.k}}</text>
      <text class="info-v">{{item.v}}</text>
    </view>
  </view>

  <!-- 客人看到的总价：每人报价 × 人数。内部核算不在这里。 -->
  <view class="cp-price" wx:if="{{guestTotalText}}">
    <view class="cp-price-k">{{c.guestTotalLabel}}</view>
    <view class="cp-price-v">{{guestTotalText}}</view>
    <view class="cp-price-note">{{guestTotalNote}}</view>
  </view>

  <!-- 按天行程 -->
  <view class="cp-plan">
    <view class="cp-day" wx:for="{{dayList}}" wx:key="index" wx:for-item="day">
      <view class="cp-day-scene">
        <text class="cp-day-no">第{{day.index + 1}}</text>
        <text class="cp-day-unit">{{c.dayUnit}}</text>
        <text class="cp-day-dot">·</text>
        <text class="cp-day-name">{{day.scene}}</text>
      </view>

      <view class="cp-spots">
        <view class="cp-spot" wx:for="{{day.scenics}}" wx:key="id" bindtap="goScenic" data-id="{{item.id}}">
          <view class="cp-thumb"><image class="cp-thumb-img" src="{{item.img}}" mode="aspectFill" /></view>
          <view class="cp-spot-body">
            <view class="cp-spot-name">{{item.name}}</view>
            <view class="cp-spot-sub">{{item.dest}}</view>
          </view>
          <view class="cp-arrow">›</view>
        </view>
        <view class="cp-spots-empty" wx:if="{{day.scenics.length === 0}}">
          <text class="cp-dot-row"></text>
          <text class="cp-empty-text">{{c.noScenic}}</text>
        </view>
      </view>

      <view class="cp-hotel" wx:if="{{day.hotel}}" bindtap="goHotel" data-id="{{day.hotel.id}}">
        <view class="cp-thumb"><image class="cp-thumb-img" src="{{day.hotel.img}}" mode="aspectFill" /></view>
        <view class="cp-spot-body">
          <view class="cp-spot-name">{{c.hotelLabel}} · {{day.hotel.name}}</view>
          <view class="cp-spot-sub">{{day.hotel.meta}}</view>
          <view class="cp-spot-sub" wx:if="{{day.hotel.roomType}}">房型：{{day.hotel.roomType}} · {{day.hotel.qty}} 间</view>
          <view class="cp-spot-sub" wx:elif="{{day.hotel.qty}}">{{day.hotel.qty}} 间</view>
        </view>
        <view class="cp-arrow">›</view>
      </view>

      <view class="cp-alt" wx:if="{{day.hotel && day.hotel.alts.length > 0}}">
        <view class="cp-alt-title">{{c.hotelAltTitle}}</view>
        <view class="cp-alt-list">
          <text class="cp-alt-name" wx:for="{{day.hotel.alts}}" wx:key="*this">{{item}}</text>
        </view>
      </view>

      <view class="cp-promo" wx:if="{{day.promos.length}}">
        <image class="cp-promo-img" wx:for="{{day.promos}}" wx:for-item="pic" wx:key="*this" src="{{pic}}" mode="aspectFill" />
      </view>

      <view class="cp-note" wx:if="{{day.note}}">
        <view class="cp-note-label">{{c.noteLabel}}</view>
        <view class="cp-note-text">{{day.note}}</view>
      </view>
    </view>
  </view>

  <!-- 总体温馨提示 -->
  <view class="cp-commercial">
    <view class="cp-tips">
      <view class="sec-title">{{c.tipsTitle}}</view>
      <view class="rd-note-line" wx:for="{{overallTips}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <!-- 出行说明（全局固定模板） -->
  <view class="cp-commercial cp-travel">
    <view class="cp-banner">{{c.travel.banner}}</view>

    <view class="sec">
      <view class="sec-title">{{d.feeInclude}}</view>
      <view class="sec-item" wx:for="{{travelView.include}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="sec">
      <view class="sec-title">{{d.feeExclude}}</view>
      <view class="sec-item" wx:for="{{travelView.exclude}}" wx:key="*this">{{item}}</view>
    </view>

    <view class="sec">
      <view class="sec-title">{{d.notice}}</view>
      <view class="sec-sub">{{d.noticeItems[0]}}</view>
      <view class="sec-item" wx:for="{{travelView.tips}}" wx:key="*this">{{item}}</view>
      <view class="sec-sub">{{d.noticeItems[1]}}</view>
      <view class="sec-chips">
        <text class="chip" wx:for="{{travelView.gear}}" wx:key="*this">{{item}}</text>
      </view>
    </view>

    <view class="sec">
      <view class="sec-title">{{d.refund}}</view>
      <view class="sec-item" wx:for="{{travelView.refund}}" wx:key="*this">{{item}}</view>
    </view>
  </view>

  <!-- 内部核算只给员工，放在全部行程内容之后 -->
  <view class="cp-price" wx:if="{{isStaff && internalView}}">
    <view class="cp-price-k">内部核算</view>
    <view class="cp-price-v">¥{{internalView.total}}</view>
    <view class="cp-price-note">{{internalView.note}}</view>
  </view>

  <!-- 底部：有对客报价时总价留在操作栏旁，生成后仍可修改 -->
  <view class="cp-bottom">
    <view class="cp-price-side" wx:if="{{guestTotalText}}">
      <text class="cp-price-side-k">{{c.guestTotalLabel}}</text>
      <text class="cp-price-side-v">{{guestTotalText}}</text>
    </view>
    <view class="cp-btn cp-btn-outline" bindtap="goEdit">{{c.editBtn}}</view>
    <view class="cp-btn cp-btn-outline" wx:if="{{!fromList}}" bindtap="saveToMine">{{c.saveBtn}}</view>
  </view>
  <view class="cp-safe"></view>
</view>