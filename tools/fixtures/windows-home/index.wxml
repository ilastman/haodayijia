<wxs src="../../utils/media.wxs" module="media" />
<view class="home-page">

  <!-- 顶栏：首屏透在封面上，下滑后粘在顶部并收成实底搜索条。胶囊按钮是系统的，这里只留出位置。 -->
  <view class="top-chrome {{chromeSolid ? 'is-solid' : ''}}" style="height: {{chromeHeight}}px; padding-top: {{menuTop}}px;">
    <view class="chrome-row" style="height: {{navRowHeight}}px; padding-right: {{capsuleGap}}px;">
      <view class="search-pill" hover-class="search-pill-on" bindtap="onSearch">
        <view class="search-ico"></view>
        <text class="search-ph">{{home.searchPlaceholder}}</text>
      </view>
    </view>
  </view>

  <!-- 1. 首屏封面：高度=可视窗口，图用 aspectFill 铺满，不留边 -->
  <view class="home-hero" style="height: {{heroHeight}}px; margin-top: -{{chromeHeight}}px;">
    <swiper wx:if="{{banners.length}}" class="banner" style="height: {{heroHeight}}px;" indicator-dots="{{true}}" indicator-color="rgba(255,255,255,.55)" indicator-active-color="#FFFFFF"
      autoplay="{{true}}" circular="{{true}}" interval="4000" duration="480">
      <swiper-item wx:for="{{banners}}" wx:key="id" bindtap="onBanner" data-id="{{item.routeId}}" data-jump="{{item.jumpRoute}}">
        <video wx:if="{{media.isVideo(item.image)}}" class="banner-img" src="{{item.image}}" autoplay="{{true}}" loop="{{true}}" muted="{{true}}" controls="{{false}}" show-center-play-btn="{{false}}" object-fit="cover" style="height: {{heroHeight}}px;width:100%;" />
        <image wx:else class="banner-img" src="{{item.image}}" mode="aspectFill" style="height: {{heroHeight}}px;" />
        <view class="banner-shade"></view>
        <view class="banner-scrim"></view>
      </swiper-item>
    </swiper>
  </view>

  <!-- 2. 私人定制名片（代替原金刚区入口） -->
  <view class="custom-card" hover-class="custom-card-on" bindtap="goCustom" aria-role="button" aria-label="定制一段专属冬旅">
    <image class="custom-card-img" src="/images/home/custom-card.jpg" mode="widthFix" />
    <view class="custom-flake-wrap" aria-hidden="true">
      <image class="custom-flake" src="/images/home/custom-snowflake.png" mode="aspectFit" />
    </view>
  </view>

  <!-- 3. 图标导航：名片下方，五项等分 -->
  <view class="nav-bar">
    <view class="nav-item" hover-class="nav-item-on" wx:for="{{navIcons}}" wx:key="key" bindtap="onNav" data-url="{{item.url}}">
      <view class="nav-icon">
        <image class="nav-icon-img" src="{{item.icon}}" mode="aspectFit" />
      </view>
      <text class="nav-label">{{item.label}}</text>
    </view>
  </view>

  <!-- 4. 热门呼伦贝尔线路 -->
  <view class="section">
    <view class="section-head">
      <view class="section-title">{{home.hotTitle}}</view>
      <view class="section-more" bindtap="goRoutes">{{home.more}} ›</view>
    </view>
    <scroll-view scroll-x="{{true}}" enhanced="{{true}}" show-scrollbar="{{false}}" class="hot-scroll">
      <view class="hot-card" wx:for="{{hotRoutes}}" wx:key="id">
        <route-card item="{{item}}" mode="wide" />
      </view>
      <view class="hot-holder"></view>
    </scroll-view>
  </view>

  <!-- 5. 目的地直达 -->
  <view class="section">
    <view class="section-head">
      <view class="section-title">{{home.destTitle}}</view>
    </view>
    <view class="dest-grid">
      <view class="dest-item" wx:for="{{destinations}}" wx:key="name" bindtap="onDest" data-name="{{item.name}}">
        <video wx:if="{{media.isVideo(item.image)}}" class="dest-img" src="{{item.image}}" autoplay="{{true}}" loop="{{true}}" muted="{{true}}" controls="{{false}}" show-center-play-btn="{{false}}" object-fit="cover" /><image wx:else class="dest-img" src="{{item.image}}" mode="aspectFill" lazy-load="{{true}}" />
        <view class="dest-mask"></view>
        <view class="dest-name">{{item.name}}</view>
      </view>
    </view>
  </view>

  <!-- 6. 特惠推荐 -->
  <view class="section">
    <view class="section-head">
      <view class="section-title">{{home.offerTitle}}</view>
      <view class="section-more" bindtap="goRoutes">{{home.more}} ›</view>
    </view>
    <view class="offer-card" wx:for="{{offers}}" wx:key="id" bindtap="goDetail" data-id="{{item.id}}">
      <video wx:if="{{media.isVideo(item.cover)}}" class="offer-img" src="{{item.cover}}" autoplay="{{true}}" loop="{{true}}" muted="{{true}}" controls="{{false}}" show-center-play-btn="{{false}}" object-fit="cover" /><image wx:else class="offer-img" src="{{item.cover}}" mode="aspectFill" lazy-load="{{true}}" />
      <view class="offer-info">
        <view class="offer-title ellipsis-2">{{item.title}}</view>
        <view class="tags">
          <text class="tag tag-gold" wx:for="{{item.tags}}" wx:for-item="t" wx:key="*this">{{t}}</text>
        </view>
        <view class="offer-meta">{{item.days}}天 · {{item.departure}} · {{item.type}}</view>
        <view class="offer-price-row">
          <view class="price">
            <text class="price-symbol">¥</text>
            <text class="price-num">{{item.price}}</text>
            <text class="per">/人起</text>
          </view>
          <text class="price-old" wx:if="{{item.originalPrice}}">¥{{item.originalPrice}}</text>
        </view>
      </view>
    </view>
  </view>

  <!-- 7. 公司介绍 -->
  <view class="intro">
    <view class="section-title">{{home.introTitle}}</view>
    <text class="intro-text">{{companyIntro}}</text>
    <view class="intro-phone">客服电话：{{servicePhone}}</view>
  </view>

  <view class="safe-bottom"></view>

  <!-- 6. 底部悬浮立即咨询 -->
  <view class="float-consult" bindtap="openConsult">
    <image class="float-icon" src="{{serviceIcon}}" mode="aspectFit" />
    <text>{{home.consult}}</text>
  </view>

  <consult-modal visible="{{consultVisible}}" bind:close="onConsultClose" />
</view>
